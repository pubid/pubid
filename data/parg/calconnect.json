ll,"preprocess":null},{"capture":"number","path":"number","type":"string","card":null,"preprocess":null},{"capture":"year","path":"year","type":"string","card":null,"preprocess":null},{"capture":"month","path":"month","type":"string","card":null,"preprocess":null},{"capture":"day","path":"day","type":"string","card":null,"preprocess":null}]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":"identifier","render":{},"derive":{},"tests":[{"entry":"identifier","kind":"accept","input":"CC 9101","expect":{}},{"entry":"identifier","kind":"accept","input":"CC/CD 9101","expect":{}},{"entry":"identifier","kind":"accept","input":"CC 9101:2024","expect":{}},{"entry":"identifier","kind":"reject","input":"nonsense","expect":{}}],"docs":{},"source":"# Port of lib/pubid/calconnect/parser.rb:\n# CC[/<series>] <number>[.<sub>|-$sub>][:<date>]\n\ngrammar PubidCalconnect version \"0.1.0\" edition \"v2\" {\n  letter = %x41-5A / %x61-7A\n  series = (1*letter) as series\n  number = (1*digit [(\".\" / \"-\") 1*digit]) as number\n  date = (1*digit) as year [(\"-\" (1*digit) as month \"-\" (1*digit) as day)]\n  identifier = \"CC\" [slash series] space number [(colon date)]\n  digit = %x30-39\n  space = \" \"\n  slash = \"/\"\n  colon = \":\"\n  entry identifier: identifier\n\n  # Typed model bindings: every bound capture lands directly on the\n  # attribute of the same name in the consumer's identifier model.\n  bindings identifier {\n    series -> series (string)\n    number -> number (string)\n    year -> year (string)\n    month -> month (string)\n    day -> day (string)\n  }\n\n  test {\n    accept \"CC 9101\"\n    accept \"CC/CD 9101\"\n    accept \"CC 9101:2024\"\n    reject \"nonsense\"\n  }\n}\n","source_hash":"224fcedd1385fec4491afbe673c42ab7e036ff09eb376675573ae731a0f87898","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.114","edition":2,"checksum":"sha256:73daf108c73f8cf32ace8769877157c8425a9ca293ca8db03bf77f32a8e6b381"}
