path":"language","type":"string","card":null,"preprocess":null},{"capture":"all_parts","path":"all_parts","type":"string","card":null,"preprocess":null},{"capture":"amd_type","path":"amd_type","type":"string","card":null,"preprocess":null},{"capture":"amd_number","path":"amd_number","type":"string","card":null,"preprocess":null},{"capture":"amd_year","path":"amd_year","type":"string","card":null,"preprocess":null},{"capture":"amd_reaffirmed","path":"amd_reaffirmed","type":"string","card":null,"preprocess":null},{"capture":"expl_type","path":"expl_type","type":"string","card":null,"preprocess":null},{"capture":"expl_number","path":"expl_number","type":"string","card":null,"preprocess":null},{"capture":"corr_type","path":"corr_type","type":"string","card":null,"preprocess":null},{"capture":"corr_number","path":"corr_number","type":"string","card":null,"preprocess":null},{"capture":"corr_year","path":"corr_year","type":"string","card":null,"preprocess":null},{"capture":"corr_reaffirmed","path":"corr_reaffirmed","type":"string","card":null,"preprocess":null},{"capture":"symbol_present","path":"symbol_present","type":"string","card":null,"preprocess":null},{"capture":"symbol_value","path":"symbol_value","type":"string","card":null,"preprocess":null}]}},"preprocess":{},"tables":{},"lint":{"order_warnings":["rule supplement: branches 1 and 2 are order-dependent (shared first bytes; ordered choice is decisive)","rule supplement: branches 1 and 3 are order-dependent (shared first bytes; ordered choice is decisive)","rule supplement: branches 2 and 3 are order-dependent (shared first bytes; ordered choice is decisive)","rule symbol_value_char: branches 1 and 2 are order-dependent (first set not statically known)","rule identifier: branches 1 and 2 are order-dependent (shared first bytes; ordered choice is decisive)"]},"default_entry":"identifier","render":{},"derive":{},"tests":[{"entry":"identifier","kind":"accept","input":"JIS B 0001","expect":{}},{"entry":"identifier","kind":"accept","input":"JIS X 0208:1997","expect":{}},{"entry":"identifier","kind":"accept","input":"WES 7700-1:2019","expect":{}},{"entry":"identifier","kind":"accept","input":"WES 7301:2020R","expect":{}},{"entry":"identifier","kind":"reject","input":"nonsense","expect":{}},{"entry":"identifier","kind":"reject","input":"JIS WES 7700","expect":{}},{"entry":"identifier","kind":"reject","input":"WES X 7700","expect":{}}],"docs":{},"source":"# Port of lib/pubid/jis/parser.rb — JIS identifiers with the Japanese\n# full-width separator tolerance (ｰ 　 ： （）), TR/TS prefixes, parts,\n# reaffirmed years, (E)/(J) language codes, 規格群 all-parts, AMD/EXPL/\n# CORR supplements, and the SYMBOL clause. WES (Japan Welding Engineering\n# Society) ids share the JIS tail but carry no series letter or JIS prefix.\n\ngrammar PubidJis version \"0.1.0\" edition 2 {\n  dash = (\"-\" / \"ｰ\") as dash\n  space = (\" \" / \"　\")\n  colon = (\":\" / \"：\")\n  type_prefix = (\"TR\" / \"TS\") as type (space / slash)\n  series = %x41-5A as series\n  number = (1*digit) as number\n  part = dash (1*digit) as part\n  parts = (*part) as parts\n  reaffirmed = \"R\" (*\"R\")\n  year = colon (1*digit) as year ([\"R\" (*\"R\")]) as reaffirmed\n  language = (\"(\" / \"（\") (\"E\" / \"J\") as language (\")\" / \"）\")\n  all_parts = ((\"（\" \"規格群\" \"）\") / (\"(\" \"規格群\" \")\")) as all_parts\n  amendment = slash (\"AMENDMENT\" / \"AMD\") as amd_type space (1*digit) as amd_number colon (1*digit) as amd_year ([\"R\" (*\"R\")]) as amd_reaffirmed\n  explanation = slash (\"EXPLANATION\" / \"EXPL\") as expl_type ([space (1*digit) as expl_number])\n  corrigendum = slash (\"CORRIGENDUM\" / \"CORR\") as corr_type space (1*digit) as corr_number colon (1*digit) as corr_year ([\"R\" (*\"R\")]) as corr_reaffirmed\n  supplement = (amendment as amendment) / (explanation as explanation) / (corrigendum as corrigendum)\n  symbol_value_char = %x01-09 / %x0B-10FFFF\n  symbol_clause = space \"SYMBOL\" as symbol_present ([space (1*symbol_value_char) as symbol_value])\n  wes_identifier = \"WES\" as wes space number parts [year] [language] [all_parts] [supplement] [symbol_clause]\n  jis_identifier = [\"JIS\" [(space / slash)]] [type_prefix] [space] series [space] number parts [year] [language] [all_parts] [supplement] [symbol_clause]\n  identifier = wes_identifier / jis_identifier\n  upper = %x41-5A\n  digit = %x30-39\n  slash = \"/\"\n  entry identifier: identifier\n\n  # Typed model bindings: bound captures land on the consumer\n  # builder's fields of the same name; repeated parts collect under\n  # parts[].part.\n  bindings identifier {\n    wes -> wes (string)\n    type -> type (string)\n    series -> series (string)\n    number -> number (string)\n    part -> parts[].part (string)\n    year -> year (string)\n    reaffirmed -> reaffirmed (string)\n    language -> language (string)\n    all_parts -> all_parts (string)\n    amd_type -> amd_type (string)\n    amd_number -> amd_number (string)\n    amd_year -> amd_year (string)\n    amd_reaffirmed -> amd_reaffirmed (string)\n    expl_type -> expl_type (string)\n    expl_number -> expl_number (string)\n    corr_type -> corr_type (string)\n    corr_number -> corr_number (string)\n    corr_year -> corr_year (string)\n    corr_reaffirmed -> corr_reaffirmed (string)\n    symbol_present -> symbol_present (string)\n    symbol_value -> symbol_value (string)\n  }\n\n  \n  test {\n    accept \"JIS B 0001\"\n    accept \"JIS X 0208:1997\"\n    accept \"WES 7700-1:2019\"\n    accept \"WES 7301:2020R\"\n    reject \"nonsense\"\n    reject \"JIS WES 7700\"\n    reject \"WES X 7700\"\n  }\n}\n","source_hash":"cee4b9e9e0254a2e48e9c1bbc9b4c13684765434ddcd309b58be70a85611f798","unicode_tables":"onigmo (Ruby 3.4.10)","compiler_version":"1.3.114","edition":2,"checksum":"sha256:67d1e26097f00ecaac49d17b5955421c1ee3969b4d25269c6b76ee58c8f102dc"}
