,"card":null,"preprocess":null},{"capture":"corr_type","path":"corr_type","type":"string","card":null,"preprocess":null},{"capture":"corr_number","path":"corr_number","type":"string","card":null,"preprocess":null},{"capture":"corr_year","path":"corr_year","type":"string","card":null,"preprocess":null},{"capture":"corr_reaffirmed","path":"corr_reaffirmed","type":"string","card":null,"preprocess":null},{"capture":"symbol_present","path":"symbol_present","type":"string","card":null,"preprocess":null},{"capture":"symbol_value","path":"symbol_value","type":"string","card":null,"preprocess":null}]}},"preprocess":{},"tables":{},"lint":{"order_warnings":["rule supplement: branches 1 and 2 are order-dependent (shared first bytes; ordered choice is decisive)","rule supplement: branches 1 and 3 are order-dependent (shared first bytes; ordered choice is decisive)","rule supplement: branches 2 and 3 are order-dependent (shared first bytes; ordered choice is decisive)","rule symbol_value_char: branches 1 and 2 are order-dependent (first set not statically known)","rule identifier: branches 1 and 2 are order-dependent (shared first bytes; ordered choice is decisive)"]},"default_entry":"identifier","render":{},"derive":{},"tests":[{"entry":"identifier","kind":"accept","input":"JIS B 0001","expect":{}},{"entry":"identifier","kind":"accept","input":"JIS X 0208:1997","expect":{}},{"entry":"identifier","kind":"accept","input":"WES 7700-1:2019","expect":{}},{"entry":"identifier","kind":"accept","input":"WES 7301:2020R","expect":{}},{"entry":"identifier","kind":"reject","input":"JIS WES 7700","expect":{}},{"entry":"identifier","kind":"reject","input":"WES X 7700","expect":{}},{"entry":"identifier","kind":"reject","input":"nonsense","expect":{}},{"entry":"identifier","kind":"example","input":"WES 7700-1:2019","expect":{"wes":"WES","number":"7700","year":"2019"}},{"entry":"identifier","kind":"example","input":"WES 7301:2020R","expect":{"wes":"WES","number":"7301","year":"2020","reaffirmed":"R"}},{"entry":"identifier","kind":"example","input":"JIS X 0208:1997","expect":{"series":"X","number":"0208","year":"1997"}},{"entry":"identifier","kind":"example","input":"WES 7700:2019/AMD 1:2020R","expect":{"wes":"WES","number":"7700","amd_type":"AMD","amd_number":"1","amd_year":"2020","amd_reaffirmed":"R"}},{"entry":"identifier","kind":"example","input":"JIS X 0208:1997R","expect":{"series":"X","year":"1997","reaffirmed":"R"}},{"entry":"identifier","kind":"example","input":"JIS X 0208:1997RR","expect":{"series":"X","year":"1997","reaffirmed":"RR"}}],"docs":{},"source":"# Port of lib/pubid/jis/parser.rb — JIS identifiers with the Japanese\n# full-width separator tolerance (ｰ 　 ： （）), TR/TS prefixes, parts,\n# reaffirmed years, (E)/(J) language codes, 規格群 all-parts, AMD/EXPL/\n# CORR supplements, and the SYMBOL clause. WES (Japan Welding Engineering\n# Society) ids share the JIS tail but carry no series letter or JIS prefix.\n\ngrammar PubidJis version \"0.1.0\" edition 2 {\n  dash = (\"-\" / \"ｰ\") as dash\n  space = (\" \" / \"　\")\n  colon = (\":\" / \"：\")\n  type_prefix = (\"TR\" / \"TS\") as type (space / slash)\n  series = %x41-5A as series\n  number = (1*digit) as number\n  part = dash (1*digit) as part\n  parts = (*part) as parts\n  reaffirmed = \"R\" (*\"R\")\n  year = colon (1*digit) as year [reaffirmed_rule]\n  language = (\"(\" / \"（\") (\"E\" / \"J\") as language (\")\" / \"）\")\n  all_parts = ((\"（\" \"規格群\" \"）\") / (\"(\" \"規格群\" \")\")) as all_parts\n  amendment = {\n    slash (\"AMENDMENT\" / \"AMD\") as amd_type\n    space\n    (1*digit) as amd_number\n    colon (1*digit) as amd_year\n    ([\"R\" (*\"R\")]) as amd_reaffirmed\n  }\n  explanation = {\n    slash (\"EXPLANATION\" / \"EXPL\") as expl_type\n    ([space (1*digit) as expl_number])\n  }\n  corrigendum = {\n    slash (\"CORRIGENDUM\" / \"CORR\") as corr_type\n    space\n    (1*digit) as corr_number\n    colon (1*digit) as corr_year\n    ([\"R\" (*\"R\")]) as corr_reaffirmed\n  }\n  supplement = {\n    (amendment as amendment)\n    / (explanation as explanation)\n    / (corrigendum as corrigendum)\n  }\n  symbol_value_char = %x01-09 / %x0B-10FFFF\n  symbol_clause = {\n    space \"SYMBOL\" as symbol_present\n    ([space (1*symbol_value_char) as symbol_value])\n  }\n  wes_identifier = {\n    \"WES\" as wes\n    space\n    number\n    parts\n    [year]\n    [language]\n    [all_parts]\n    [supplement]\n    [symbol_clause]\n  }\n  jis_identifier = {\n    [\"JIS\" [(space / slash)]]\n    [type_prefix]\n    [space]\n    series\n    [space]\n    number\n    parts\n    [year]\n    [language]\n    [all_parts]\n    [supplement]\n    [symbol_clause]\n  }\n  identifier = wes_identifier / jis_identifier\n  upper = %x41-5A\n  digit = %x30-39\n  slash = \"/\"\n  reaffirmed_rule = (\"R\" (*\"R\")) as reaffirmed\n  entry identifier: identifier\n\n  # Typed model bindings: bound captures land on the consumer\n  # builder's fields of the same name; repeated parts collect under\n  # parts[].part.\n  bindings identifier {\n    wes -> wes (string)\n    type -> type (string)\n    series -> series (string)\n    number -> number (string)\n    part -> parts[].part (string)\n    year -> year (string)\n    reaffirmed -> reaffirmed (string)\n    language -> language (string)\n    all_parts -> all_parts (string)\n    amd_type -> amd_type (string)\n    amd_number -> amd_number (string)\n    amd_year -> amd_year (string)\n    amd_reaffirmed -> amd_reaffirmed (string)\n    expl_type -> expl_type (string)\n    expl_number -> expl_number (string)\n    corr_type -> corr_type (string)\n    corr_number -> corr_number (string)\n    corr_year -> corr_year (string)\n    corr_reaffirmed -> corr_reaffirmed (string)\n    symbol_present -> symbol_present (string)\n    symbol_value -> symbol_value (string)\n  }\n\n  test {\n    accept \"JIS B 0001\"\n    accept \"JIS X 0208:1997\"\n    accept \"WES 7700-1:2019\"\n    accept \"WES 7301:2020R\"\n    reject \"JIS WES 7700\"\n    reject \"WES X 7700\"\n    reject \"nonsense\"\n    example \"WES 7700-1:2019\" { wes: \"WES\", number: \"7700\", year: \"2019\" }\n    example \"WES 7301:2020R\" { wes: \"WES\", number: \"7301\", year: \"2020\", reaffirmed: \"R\" }\n    example \"JIS X 0208:1997\" { series: \"X\", number: \"0208\", year: \"1997\" }\n    example \"WES 7700:2019/AMD 1:2020R\" { wes: \"WES\", number: \"7700\", amd_type: \"AMD\", amd_number: \"1\", amd_year: \"2020\", amd_reaffirmed: \"R\" }\n    example \"JIS X 0208:1997R\" { series: \"X\", year: \"1997\", reaffirmed: \"R\" }\n    example \"JIS X 0208:1997RR\" { series: \"X\", year: \"1997\", reaffirmed: \"RR\" }\n  }\n}\n","source_hash":"bb68f75e3e1d9b7e79613bd6cff60ccd77f6e2e68ace2569a2fbc968543b1f3d","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.121","edition":2,"semantics_hash":"sha256:b16cf5d2687fef91bb0c21ce6b417cf9d9dfcf9aec0280169acb246f48d6b22b","checksum":"sha256:156eb10c6a7638055e3ca2556c6bf62ecca6521b432c828269cdcbab080c44be"}
