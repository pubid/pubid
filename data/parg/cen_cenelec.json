1,"max":null,"tag":"Repetition"}},{"Str":{"pattern":"."}},{"Re":{"pattern":"[\\x30-\\x39]"}},{"Repetition":{"atom":222,"min":1,"max":null,"tag":"Repetition"}},{"Sequence":{"atoms":[214,215,217,218,220,221,223]}},{"Named":{"name":"version","atom":224}},{"Repetition":{"atom":213,"min":0,"max":1,"tag":"Maybe"}},{"Entity":{"atom":81}},{"Repetition":{"atom":227,"min":0,"max":1,"tag":"Maybe"}},{"Sequence":{"atoms":[210,211,212,226,228]}},{"Repetition":{"atom":229,"min":0,"max":1,"tag":"Maybe"}},{"Entity":{"atom":234}},{"Entity":{"atom":175}},{"Repetition":{"atom":232,"min":0,"max":null,"tag":"Repetition"}},{"Named":{"name":"supplements","atom":233}},{"Entity":{"atom":183}},{"Repetition":{"atom":235,"min":0,"max":1,"tag":"Maybe"}},{"Sequence":{"atoms":[105,193,209,230,231,236]}},{"Alternative":{"atoms":[0,237]}}],"root":238},"bindings":[{"capture":"publisher","path":"publisher","type":"string","card":null,"preprocess":null},{"capture":"copublisher","path":"copublishers[].copublisher","type":"string","card":null,"preprocess":null},{"capture":"type_with_stage","path":"type_with_stage","type":"string","card":null,"preprocess":null},{"capture":"type","path":"type","type":"string","card":null,"preprocess":null},{"capture":"number","path":"number","type":"string","card":null,"preprocess":null},{"capture":"version","path":"version","type":"string","card":null,"preprocess":null},{"capture":"part","path":"parts[].part","type":"string","card":null,"preprocess":null},{"capture":"year","path":"year","type":"string","card":null,"preprocess":null},{"capture":"adopted_string","path":"adopted_string","type":"string","card":null,"preprocess":null},{"capture":"edition","path":"edition","type":"string","card":null,"preprocess":null},{"capture":"amendment_number","path":"amendment_number","type":"string","card":null,"preprocess":null},{"capture":"amendment_year","path":"amendment_year","type":"string","card":null,"preprocess":null},{"capture":"fragment_number","path":"fragment_number","type":"string","card":null,"preprocess":null},{"capture":"supplement","path":"supplements[].supplement","type":"raw","card":null,"preprocess":null}]}},"preprocess":{},"tables":{},"lint":{"order_warnings":["rule publisher: branches 1 and 2 are order-dependent (shared first bytes; ordered choice is decisive)","rule publisher: branches 1 and 3 are order-dependent (shared first bytes; ordered choice is decisive)","rule publisher: branches 2 and 3 are order-dependent (shared first bytes; ordered choice is decisive)","rule date: branches 1 and 2 are order-dependent (shared first bytes; ordered choice is decisive)","rule fragment_identifier: branches 1 and 2 are order-dependent (shared first bytes; ordered choice is decisive)","rule identifier: branches 1 and 2 are order-dependent (shared first bytes; ordered choice is decisive)"]},"default_entry":"identifier","render":{},"derive":{},"tests":[{"entry":"identifier","kind":"accept","input":"EN 18216:2026","expect":{}},{"entry":"identifier","kind":"accept","input":"EN ISO 9001:2015","expect":{}},{"entry":"identifier","kind":"accept","input":"CEN/CLC TR 17161:2019","expect":{}},{"entry":"identifier","kind":"accept","input":"EN 196-1:2016+A1","expect":{}},{"entry":"identifier","kind":"accept","input":"CEN/CLC/ETSI/TR 101551:2026","expect":{}},{"entry":"identifier","kind":"accept","input":"EN 302 326-2:2026","expect":{}},{"entry":"identifier","kind":"accept","input":"EN 302 326-2 V2.2.1","expect":{}},{"entry":"identifier","kind":"accept","input":"EN 302 326 V2.2.1:2026","expect":{}},{"entry":"identifier","kind":"accept","input":"EN 302:2026","expect":{}},{"entry":"identifier","kind":"reject","input":"nonsense","expect":{}}],"docs":{},"source":"# Port of lib/pubid/cen_cenelec/parser.rb. Pre-parse normalization\n# (U+2011/AD dashes, comment stripping, CEN-CLC/GUIDE forms) stays\n# binder-side: the grammar sees normalized input.\n#\n# Edition 2: every reference inside a captured body is inlined to raw\n# terms (a rule reference materializes as a named node in the edition-2\n# tree, so only a raw capture binds a scalar span); references to rules\n# that themselves capture (copublisher, part, month_digits,\n# year_with_month, supplement) float their captures unchanged. The\n# repetition wrappers (copublishers, parts, supplements) keep the v1\n# tree shape and the bindings name the scalar leaves.\n\ngrammar PubidCenCenelec version \"0.2.0\" edition 2 {\n  space = \" \"\n  slash = \"/\"\n  publisher = {\n    (\"CWA\" / \"HD\" / \"ES\" / \"CR\" / \"ENV\") as publisher\n    / ((\"EN\" / \"CEN\") as publisher [copublishers])\n    / (\"CLC\" as publisher [copublishers])\n  }\n  copublishers = (1*copublisher) as copublishers\n  copublisher = (\"/\" (\"CLC\" / \"ETSI\") as copublisher)\n  stage_prefix = (\"FprEN\" / \"prEN\") as type_with_stage\n  type = (\"Guide\" / \"GUIDE\" / \"TR\" / \"TS\") as type\n  number = ((1*%x30-39) (*(\" \" (1*%x30-39)))) as number\n  version = (\" \" \"V\" (1*%x30-39) \".\" (1*%x30-39) \".\" (1*%x30-39)) as version\n  part = \"-\" (1*(%x30-39 / \"-\")) as part\n  parts = (*part) as parts\n  month_digits = {\n    (\n      \"01\" / \"02\" / \"03\" / \"04\" / \"05\" / \"06\"\n      / \"07\" / \"08\" / \"09\" / \"10\" / \"11\" / \"12\"\n    ) as month\n  }\n  year = \":\" (4*4%x30-39) as year\n  year_with_month = \":\" (4*4%x30-39) as year \"-\" month_digits\n  date = year_with_month / year\n  amendment = {\n    ((\"+\" as amd_sep_plus / \"/\" as amd_sep_slash) \"A\" (1*%x30-39) as amd_number\n     [(\":\" (4*4%x30-39) as amd_year)])\n  }\n  corrigendum = {\n    ((\"+\" as amd_sep_plus / \"/\" as amd_sep_slash) \"AC\"\n     [(%x30-39 (*%x30-39)) as cor_number]\n     [(year_with_month / (\":\" (4*4%x30-39) as year))])\n  }\n  supplement = (amendment / corrigendum) as supplement\n  supplements = (*supplement) as supplements\n  edition = \" \" \"ED\" (1*%x30-39) as edition\n  adopted_string = {\n    (\n      (\"ISO\" / \"IEC\" / \"CISPR\")\n      *((!(supplement) !(edition) (%x01-09 / %x0B-10FFFF)))\n    ) as adopted_string\n  }\n  fragment_identifier = {\n    (\n      ( (stage_prefix / publisher) \" \" number parts \" \" \"AMD\"\n        (1*%x30-39) as amendment_number\n        \" \" \"FRAG\" (1*%x30-39) as fragment_number )\n      /\n      ( (stage_prefix / publisher) \" \" number parts [year] (\"+\" / \"/\") \"A\"\n        (1*%x30-39) as amendment_number\n        [(\":\" (4*4%x30-39) as amendment_year)]\n        \" \" \"FRAG\" (1*%x30-39) as fragment_number )\n    )\n  }\n  identifier = {\n    fragment_identifier\n    / (\n      (stage_prefix / publisher)\n      [(space adopted_string)]\n      [(space type / slash type)]\n      [(space number parts [version] [year])]\n      supplements\n      [edition]\n    )\n  }\n\n  entry identifier: identifier\n\n  test {\n    accept \"EN 18216:2026\"\n    accept \"EN ISO 9001:2015\"\n    accept \"CEN/CLC TR 17161:2019\"\n    accept \"EN 196-1:2016+A1\"\n    accept \"CEN/CLC/ETSI/TR 101551:2026\"\n    accept \"EN 302 326-2:2026\"\n    accept \"EN 302 326-2 V2.2.1\"\n    accept \"EN 302 326 V2.2.1:2026\"\n    accept \"EN 302:2026\"\n    reject \"nonsense\"\n  }\n\n  bindings identifier {\n    # Shape-faithful to the v1 tree the builder reads: copublishers/parts\n    # bind as one-level arrays (cast(:copublishers) maps member\n    # [:copublisher], cast(:parts) reads member [:part]); the supplements\n    # bind uncast as the [{supplement: {...}}] array extract_supplements and\n    # build_standalone_supplement walk. The supplement-internal captures\n    # (amd_sep_*, amd_number, amd_year, cor_number, the corrigendum year)\n    # are reached only through that array — no flat bindings for them.\n    publisher -> publisher (string)\n    copublisher -> copublishers[].copublisher (string)\n    type_with_stage -> type_with_stage (string)\n    type -> type (string)\n    number -> number (string)\n    version -> version (string)\n    part -> parts[].part (string)\n    year -> year (string)\n    adopted_string -> adopted_string (string)\n    edition -> edition (string)\n    amendment_number -> amendment_number (string)\n    amendment_year -> amendment_year (string)\n    fragment_number -> fragment_number (string)\n    supplement -> supplements[].supplement (raw)\n  }\n}\n","source_hash":"dfbbc53ab1cc3c16e9587310d098dc0d06e07f69e4cbce845432a403b9d96a6a","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.114","edition":2,"checksum":"sha256:ace0e594583f0be21680fa0dff0bf223602859854c074af4107760ab5f3c4e53"}
