Entity":{"atom":6}},{"Repetition":{"atom":53,"min":0,"max":1,"tag":"Maybe"}},{"Repetition":{"atom":54,"min":0,"max":1,"tag":"Maybe"}},{"Entity":{"atom":57}},{"Str":{"pattern":"/"}},{"Named":{"name":"slash","atom":56}},{"Entity":{"atom":62}},{"Re":{"pattern":"[\\x01-\\x09]"}},{"Re":{"pattern":"[\\x0b-\\u{10ffff}]"}},{"Alternative":{"atoms":[60,61]}},{"Repetition":{"atom":59,"min":1,"max":null,"tag":"Repetition"}},{"Named":{"name":"adopted_raw","atom":63}},{"Sequence":{"atoms":[55,58,64]}},{"Repetition":{"atom":52,"min":0,"max":1,"tag":"Maybe"}},{"Entity":{"atom":79}},{"Entity":{"atom":6}},{"Repetition":{"atom":68,"min":0,"max":1,"tag":"Maybe"}},{"Repetition":{"atom":69,"min":0,"max":1,"tag":"Maybe"}},{"Str":{"pattern":"("}},{"Entity":{"atom":75}},{"Re":{"pattern":"[\\x01-\\x28]"}},{"Re":{"pattern":"[\\x2a-\\u{10ffff}]"}},{"Alternative":{"atoms":[73,74]}},{"Repetition":{"atom":72,"min":1,"max":null,"tag":"Repetition"}},{"Named":{"name":"adopted_reference_raw","atom":76}},{"Str":{"pattern":")"}},{"Sequence":{"atoms":[70,71,77,78]}},{"Repetition":{"atom":67,"min":0,"max":1,"tag":"Maybe"}},{"Sequence":{"atoms":[0,15,34,35,66,80]}}],"root":81},"bindings":[{"capture":"gost_word","path":"gost_word","type":"string","card":null,"preprocess":null},{"capture":"scope_r","path":"scope_r","type":"string","card":null,"preprocess":null},{"capture":"prefix_text","path":"prefix_text","type":"string","card":null,"preprocess":null},{"capture":"raw","path":"raw","type":"string","card":null,"preprocess":null},{"capture":"adopted_raw","path":"adopted_raw","type":"string","card":null,"preprocess":null},{"capture":"adopted_reference_raw","path":"adopted_reference_raw","type":"string","card":null,"preprocess":null}]}},"preprocess":{},"tables":{},"lint":{"order_warnings":["rule year_sep_core: branches 2 and 3 are order-dependent (shared first bytes; ordered choice is decisive)","rule any_noln_char: branches 1 and 2 are order-dependent (first set not statically known)","rule no_rparen_char: branches 1 and 2 are order-dependent (first set not statically known)"]},"default_entry":"identifier","render":{},"derive":{},"tests":[{"entry":"identifier","kind":"accept","input":"GOST 12.0.004","expect":{}},{"entry":"identifier","kind":"accept","input":"GOST R 8.568","expect":{}},{"entry":"identifier","kind":"reject","input":"nonsense","expect":{}}],"docs":{},"source":"# Port of lib/pubid/gost/parser.rb — GOST identifiers in Latin and\n# Cyrillic: ГОСТ [Р|R] [copublisher/subtype] <raw>[/adopted|(reference)].\n# prefix_text and raw are captured verbatim; the builder splits them.\n# The Cyrillic character class uses codepoint ranges (%x0410-042F\n# = А-Я, %x0430-044F = а-я), faithful to the source class.\n\ngrammar PubidGost version \"0.1.0\" edition 2 {\n  gost_word = (\"GOST\" / \"ГОСТ\") as gost_word space\n  scope_r = (\"R\" / \"Р\") as scope_r space\n  prefix_char = %x0410-042F / %x0430-044F / %x2F / %x41-5A / %x61-7A\n  prefix_text = (1*prefix_char *(space 1*prefix_char)) as prefix_text space\n  raw_body = (1*digit *((\".\" / \"-\" / \"—\" / \"–\") [space] 1*digit)) as raw\n  year_sep_core = dash / \"—\" / \"–\"\n  adopted_part = [[space]] slash (1*any_noln_char) as adopted_raw\n  adopted_reference_part = [[space]] \"(\" (1*no_rparen_char) as adopted_reference_raw \")\"\n  identifier = gost_word [scope_r] [prefix_text] raw_body [adopted_part] [adopted_reference_part]\n  any_noln_char = %x01-09 / %x0B-10FFFF\n  no_rparen_char = %x01-28 / %x2A-10FFFF\n  digit = %x30-39\n  dot = \".\"\n  dash = \"-\"\n  slash = \"/\"\n  space = \" \"\n  entry identifier: identifier\n\n  bindings identifier {\n    gost_word -> gost_word (string)\n    scope_r -> scope_r (string)\n    prefix_text -> prefix_text (string)\n    raw -> raw (string)\n    adopted_raw -> adopted_raw (string)\n    adopted_reference_raw -> adopted_reference_raw (string)\n  }\n\n\n  test {\n    accept \"GOST 12.0.004\"\n    accept \"GOST R 8.568\"\n    reject \"nonsense\"\n  }\n}\n","source_hash":"d067829f030f27bd387b4c40859702a42c66f236bef5db7b276162982175c3f4","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.114","edition":2,"checksum":"sha256:7b8220c982fc764365cd9a84f72fad328c4a9d44b13e75a8c94ead7653f34dab"}
