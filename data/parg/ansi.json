}},{"Re":{"pattern":"[\\x61-\\x7a]"}},{"Repetition":{"atom":45,"min":0,"max":1,"tag":"Repetition"}},{"Repetition":{"atom":46,"min":0,"max":1,"tag":"Maybe"}},{"Sequence":{"atoms":[42,44,47]}},{"Repetition":{"atom":48,"min":0,"max":2,"tag":"Repetition"}},{"Str":{"pattern":"-"}},{"Re":{"pattern":"[\\x30-\\x39]"}},{"Repetition":{"atom":51,"min":1,"max":null,"tag":"Repetition"}},{"Sequence":{"atoms":[50,52]}},{"Repetition":{"atom":53,"min":0,"max":1,"tag":"Maybe"}},{"Sequence":{"atoms":[41,49,54]}},{"Alternative":{"atoms":[39,55]}},{"Named":{"name":"number_with_part","atom":56}},{"Entity":{"atom":69}},{"Str":{"pattern":":"}},{"Str":{"pattern":"19"}},{"Str":{"pattern":"20"}},{"Alternative":{"atoms":[60,61]}},{"Re":{"pattern":"[\\x30-\\x39]"}},{"Repetition":{"atom":63,"min":2,"max":null,"tag":"Repetition"}},{"Re":{"pattern":"[\\x30-\\x39]"}},{"Lookahead":{"atom":65,"positive":false}},{"Sequence":{"atoms":[62,64,66]}},{"Named":{"name":"date","atom":67}},{"Sequence":{"atoms":[59,68]}},{"Repetition":{"atom":58,"min":0,"max":1,"tag":"Maybe"}},{"Entity":{"atom":82}},{"Str":{"pattern":"("}},{"Entity":{"atom":80}},{"Re":{"pattern":"[\\x61-\\x7a]"}},{"Repetition":{"atom":74,"min":2,"max":null,"tag":"Repetition"}},{"Str":{"pattern":","}},{"Repetition":{"atom":76,"min":0,"max":1,"tag":"Maybe"}},{"Sequence":{"atoms":[75,77]}},{"Repetition":{"atom":78,"min":0,"max":null,"tag":"Repetition"}},{"Named":{"name":"languages","atom":79}},{"Str":{"pattern":")"}},{"Sequence":{"atoms":[72,73,81]}},{"Repetition":{"atom":71,"min":0,"max":1,"tag":"Maybe"}},{"Sequence":{"atoms":[2,3,18,20,21,70,83]}},{"Entity":{"atom":96}},{"Str":{"pattern":"ANSI"}},{"Named":{"name":"publisher","atom":86}},{"Str":{"pattern":" "}},{"Str":{"pattern":"Std "}},{"Repetition":{"atom":89,"min":0,"max":1,"tag":"Maybe"}},{"Entity":{"atom":57}},{"Entity":{"atom":69}},{"Repetition":{"atom":92,"min":0,"max":1,"tag":"Maybe"}},{"Entity":{"atom":82}},{"Repetition":{"atom":94,"min":0,"max":1,"tag":"Maybe"}},{"Sequence":{"atoms":[87,88,90,91,93,95]}},{"Alternative":{"atoms":[0,85]}}],"root":97},"bindings":[{"capture":"publisher","path":"publisher","type":"string","card":null,"preprocess":null},{"capture":"copublisher","path":"copublishers[].copublisher","type":"string","card":null,"preprocess":null},{"capture":"number_with_part","path":"number_with_part","type":"string","card":null,"preprocess":null},{"capture":"date","path":"date","type":"string","card":null,"preprocess":null},{"capture":"languages","path":"languages","type":"string","card":null,"preprocess":null}]}},"preprocess":{},"tables":{},"lint":{"order_warnings":["rule identifier: branches 1 and 2 are order-dependent (shared first bytes; ordered choice is decisive)"]},"default_entry":"identifier","render":{},"derive":{},"tests":[{"entry":"identifier","kind":"accept","input":"ANSI C63.4","expect":{}},{"entry":"identifier","kind":"accept","input":"ANSI/IEEE C63.4","expect":{}},{"entry":"identifier","kind":"accept","input":"ANSI Std A119.1","expect":{}},{"entry":"identifier","kind":"accept","input":"ANSI X9.62-2005","expect":{}},{"entry":"identifier","kind":"accept","input":"ANSI/UL 94-2023","expect":{}},{"entry":"identifier","kind":"accept","input":"ANSI/NISO Z39.88-2004","expect":{}},{"entry":"identifier","kind":"accept","input":"ANSI/ASHRAE/IES 90.1-2019","expect":{}},{"entry":"identifier","kind":"accept","input":"ANSI/AAMI ST79:2017","expect":{}},{"entry":"identifier","kind":"reject","input":"ANSI/ul 94-2023","expect":{}},{"entry":"identifier","kind":"reject","input":"nonsense","expect":{}}],"docs":{},"source":"# Port of lib/pubid/ansi/parser.rb: ANSI [copublishers] [Std] number\n# [:year][(languages)]. The number alternatives cover letter-prefixed\n# forms (C37.06.1, N323A) and plain dotted forms (802.1b-1995).\n#\n# Edition-2 notes: letter_head_part / plain_part / year_digits bodies are\n# inlined at the capture sites (a capture wrapping a rule ref expands to\n# element hashes, while the inlined body binds as one scalar string).\n# The copublishers wrapper stays a capture so the tree keeps the\n# {copublishers: [...]} shape the builder reads; the repeats collect by\n# occurrence under copublishers[].copublisher.\n\ngrammar PubidAnsi version \"0.1.0\" edition 2 {\n  # Any uppercase developer acronym co-publishes (relaton#45): ASHRAE,\n  # UL, NISO, INCITS, HL7, ASC ... An uppercase letter, then uppercase\n  # letters or digits. The copublisher body is inlined to raw terms: bare\n  # rule refs next to a capture drop the capture or materialize stray\n  # {slash:} nodes.\n  copublisher_item = \"/\" [\" \"] ( %x41-5A 1*(%x41-5A / %x30-39) ) as copublisher\n  copublishers = ( 1*copublisher_item ) as copublishers\n  std_keyword = [\"Std \"]\n  number_with_part = {\n    (\n      ( 1*(%x41-5A) 1*(%x30-39) *3(\".\" 1*(%x30-39)) [*1(%x41-5A)] [(\"-\" 1*(%x30-39))] )\n      / ( 1*(%x30-39) *2(\".\" 1*(%x30-39) [*1(%x61-7A)]) [(\"-\" 1*(%x30-39))] )\n    ) as number_with_part\n  }\n  date = \":\" ( (\"19\" / \"20\") 2*(%x30-39) !(%x30-39) ) as date\n  languages = ( *( 2*(%x61-7A) [\",\"] ) ) as languages\n  language = \"(\" languages \")\"\n  identifier_with_copublishers = {\n    \"ANSI\" as publisher copublishers \" \" [\"Std \"] number_with_part [date] [language]\n  }\n  identifier_sole = {\n    \"ANSI\" as publisher \" \" [\"Std \"] number_with_part [date] [language]\n  }\n  identifier = identifier_with_copublishers / identifier_sole\n  upper = %x41-5A\n  lower = %x61-7A\n  digit = %x30-39\n  dot = \".\"\n  dash = \"-\"\n  colon = \":\"\n  slash = \"/\"\n  space = \" \"\n  entry identifier: identifier\n\n  bindings identifier {\n    publisher -> publisher (string)\n    copublisher -> copublishers[].copublisher (string)\n    number_with_part -> number_with_part (string)\n    date -> date (string)\n    languages -> languages (string)\n  }\n\n  test {\n    accept \"ANSI C63.4\"\n    accept \"ANSI/IEEE C63.4\"\n    accept \"ANSI Std A119.1\"\n    accept \"ANSI X9.62-2005\"\n    accept \"ANSI/UL 94-2023\"\n    accept \"ANSI/NISO Z39.88-2004\"\n    accept \"ANSI/ASHRAE/IES 90.1-2019\"\n    accept \"ANSI/AAMI ST79:2017\"\n    reject \"ANSI/ul 94-2023\"\n    reject \"nonsense\"\n  }\n}\n","source_hash":"9a6a813325d5e5898758f9038be5cc0d34b4e4078f55f96b8e63e2e53a6dfc11","unicode_tables":"onigmo (Ruby 3.4.10)","compiler_version":"1.5.1.0","edition":2,"semantics_hash":"sha256:a592ed0b5dda81c93fcf98c9c3e6520ce56dfb93983312ca02452850693d0cf4","checksum":"sha256:fa2c1388465ee69b9752907ba358a9f6c8f909e06f2415dca4c78133a44f508b","validated":{"lint_errors":0,"lint_warnings":1,"tests_total":10,"tests_failures":0,"self_test":true},"byte_checksum":"sha256:42f854707e693e3e0f880a35c070d16448e7ed1f51665c6dc552e79bd23a0e49"}
