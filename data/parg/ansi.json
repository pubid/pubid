g","card":null,"preprocess":null},{"capture":"date","path":"date","type":"string","card":null,"preprocess":null},{"capture":"languages","path":"languages","type":"string","card":null,"preprocess":null}]}},"preprocess":{},"tables":{},"lint":{"order_warnings":["rule identifier: branches 1 and 2 are order-dependent (shared first bytes; ordered choice is decisive)"]},"default_entry":"identifier","render":{},"derive":{},"tests":[{"entry":"identifier","kind":"accept","input":"ANSI C63.4","expect":{}},{"entry":"identifier","kind":"accept","input":"ANSI/IEEE C63.4","expect":{}},{"entry":"identifier","kind":"accept","input":"ANSI Std A119.1","expect":{}},{"entry":"identifier","kind":"accept","input":"ANSI X9.62-2005","expect":{}},{"entry":"identifier","kind":"accept","input":"ANSI/UL 94-2023","expect":{}},{"entry":"identifier","kind":"accept","input":"ANSI/NISO Z39.88-2004","expect":{}},{"entry":"identifier","kind":"accept","input":"ANSI/ASHRAE/IES 90.1-2019","expect":{}},{"entry":"identifier","kind":"accept","input":"ANSI/AAMI ST79:2017","expect":{}},{"entry":"identifier","kind":"accept","input":"ANSI/ISA-5.1-2009","expect":{}},{"entry":"identifier","kind":"accept","input":"ANSI/ANS-8.1-2014","expect":{}},{"entry":"identifier","kind":"accept","input":"ANSI/ISA-61511-1-2018","expect":{}},{"entry":"identifier","kind":"accept","input":"ANSI/TIA-568.2-D","expect":{}},{"entry":"identifier","kind":"accept","input":"ANSI X9.8-1-2007","expect":{}},{"entry":"identifier","kind":"reject","input":"ANSI/TIA-568.2-DE","expect":{}},{"entry":"identifier","kind":"reject","input":"ANSI X9.8-1-2007:2009","expect":{}},{"entry":"identifier","kind":"reject","input":"ANSI/ul 94-2023","expect":{}},{"entry":"identifier","kind":"reject","input":"nonsense","expect":{}}],"docs":{},"source":"# Port of lib/pubid/ansi/parser.rb: ANSI [copublishers] [Std] number\n# [:year][(languages)]. The number alternatives cover letter-prefixed\n# forms (C37.06.1, N323A) and plain dotted forms (802.1b-1995).\n#\n# Edition-2 notes: letter_head_part / plain_part / year_digits bodies are\n# inlined at the capture sites (a capture wrapping a rule ref expands to\n# element hashes, while the inlined body binds as one scalar string).\n# The copublishers wrapper stays a capture so the tree keeps the\n# {copublishers: [...]} shape the builder reads; the repeats collect by\n# occurrence under copublishers[].copublisher.\n\ngrammar PubidAnsi version \"0.1.0\" edition 2 {\n  # Any uppercase developer acronym co-publishes (relaton#45): ASHRAE,\n  # UL, NISO, INCITS, HL7, ASC ... An uppercase letter, then uppercase\n  # letters or digits. The copublisher body is inlined to raw terms: bare\n  # rule refs next to a capture drop the capture or materialize stray\n  # {slash:} nodes.\n  copublisher_item = \"/\" [\" \"] ( %x41-5A 1*(%x41-5A / %x30-39) ) as copublisher\n  copublishers = ( 1*copublisher_item ) as copublishers\n  std_keyword = [\"Std \"]\n  number_with_part = {\n    (\n      ( 1*(%x41-5A) 1*(%x30-39) *3(\".\" 1*(%x30-39)) [*1(%x41-5A)] [(\"-\" 1*(%x30-39))] [(\"-\" (\"19\" / \"20\") 2*2(%x30-39) !(%x30-39 / \":\"))] )\n      / ( 1*(%x30-39) *2(\".\" 1*(%x30-39) [*1(%x61-7A)]) [(\"-\" 1*(%x30-39))] [(\"-\" (\"19\" / \"20\") 2*2(%x30-39) !(%x30-39 / \":\"))] )\n    ) as number_with_part\n  }\n  # A revision letter after a dash: \"ANSI/TIA-568.2-D\". One uppercase\n  # letter, not the start of a word.\n  revision = \"-\" ( %x41-5A ) as revision !(%x41-5A / %x30-39)\n  date = \":\" ( (\"19\" / \"20\") 2*(%x30-39) !(%x30-39) ) as date\n  languages = ( *( 2*(%x61-7A) [\",\"] ) ) as languages\n  language = \"(\" languages \")\"\n  identifier_with_copublishers = {\n    \"ANSI\" as publisher copublishers ( \" \" / ( \"-\" as number_separator ) ) [\"Std \"] number_with_part [revision] [date] [language]\n  }\n  identifier_sole = {\n    \"ANSI\" as publisher \" \" [\"Std \"] number_with_part [revision] [date] [language]\n  }\n  identifier = identifier_with_copublishers / identifier_sole\n  upper = %x41-5A\n  lower = %x61-7A\n  digit = %x30-39\n  dot = \".\"\n  dash = \"-\"\n  colon = \":\"\n  slash = \"/\"\n  space = \" \"\n  entry identifier: identifier\n\n  bindings identifier {\n    publisher -> publisher (string)\n    copublisher -> copublishers[].copublisher (string)\n    number_separator -> number_separator (string)\n    number_with_part -> number_with_part (string)\n    revision -> revision (string)\n    date -> date (string)\n    languages -> languages (string)\n  }\n\n  test {\n    accept \"ANSI C63.4\"\n    accept \"ANSI/IEEE C63.4\"\n    accept \"ANSI Std A119.1\"\n    accept \"ANSI X9.62-2005\"\n    accept \"ANSI/UL 94-2023\"\n    accept \"ANSI/NISO Z39.88-2004\"\n    accept \"ANSI/ASHRAE/IES 90.1-2019\"\n    accept \"ANSI/AAMI ST79:2017\"\n    accept \"ANSI/ISA-5.1-2009\"\n    accept \"ANSI/ANS-8.1-2014\"\n    accept \"ANSI/ISA-61511-1-2018\"\n    accept \"ANSI/TIA-568.2-D\"\n    accept \"ANSI X9.8-1-2007\"\n    reject \"ANSI/TIA-568.2-DE\"\n    reject \"ANSI X9.8-1-2007:2009\"\n    reject \"ANSI/ul 94-2023\"\n    reject \"nonsense\"\n  }\n}\n","source_hash":"7f83a90c91a2f4d44f6f237f6846c459b2f7267bca93dfe4d35d398acc86bac4","unicode_tables":"onigmo (Ruby 3.4.10)","compiler_version":"1.5.1.0","edition":2,"semantics_hash":"sha256:a06924c35d3c09a9312502da2680f1b4443a6e9ed883b9d65677669c4765f845","checksum":"sha256:413a04b672bf55462edfc6a5113b7327d6d35652f9382402db5da6f8cae964c1","validated":{"lint_errors":0,"lint_warnings":1,"tests_total":17,"tests_failures":0,"self_test":true},"byte_checksum":"sha256:0f3b757b5be0845eda845232fa5e887e987d340876434de8f0acb6a8eb7b39a0"}
