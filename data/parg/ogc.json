ct":{}}],"docs":{},"source":"# Port of lib/pubid/ogc/parser.rb: \"<yy>-<nnn>[<revision>]\" with an\n# optional lenient \"OGC \" prefix. \\s = %x09-0D / %x20.\n\ngrammar PubidOgc version \"0.1.0\" edition \"v2\" {\n  ws_char = %x09-0D / %x20\n  space = 1*ws_char\n  digit = %x30-39\n  alnum_char = %x41-5A / %x61-7A / %x30-39\n  revision = (1*alnum_char) as revision\n  identifier = [\"OGC\" space] (1*digit) as year \"-\" (1*digit) as number [revision] [*ws_char]\n  entry identifier: identifier\n\n  # Typed model bindings: every bound capture lands on the\n  # consumer model's field of the same name.\n  bindings identifier {\n    revision -> revision (string)\n    year -> year (string)\n    number -> number (string)\n  }\n\n\n  test {\n    accept \"OGC 06-121r9\"\n    accept \"20-024\"\n    reject \"nonsense\"\n  }\n}\n","source_hash":"b1683c545f8fcf68d9aa944eb10807e74a74bbc9cf39c459892ad7eed5ad0a25","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.112","edition":"v2","checksum":"sha256:6b60693f065f5d81abbe3893be939dd4bf61171a97924e9341345d82772200ec"}
