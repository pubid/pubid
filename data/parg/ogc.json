revision>]\" with an\n# optional lenient \"OGC \" prefix. \\s = %x09-0D / %x20.\n\ngrammar PubidOgc version \"0.1.0\" edition 2 {\n  ws_char = %x09-0D / %x20\n  space = 1*ws_char\n  digit = %x30-39\n  alnum_char = %x41-5A / %x61-7A / %x30-39\n  revision = (1*alnum_char) as revision\n  identifier = [\"OGC\" space] (1*digit) as year \"-\" (1*digit) as number [revision] [*ws_char]\n  entry identifier: identifier\n\n  # Typed model bindings: every bound capture lands on the\n  # consumer model's field of the same name.\n  bindings identifier {\n    revision -> revision (string)\n    year -> year (string)\n    number -> number (string)\n  }\n\n\n  test {\n    accept \"OGC 06-121r9\"\n    accept \"20-024\"\n    reject \"nonsense\"\n  }\n}\n","source_hash":"6b50117ba5001d4f9b43acc6a0b86de4e6b98be60188bd02a57e8ec094401f84","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.114","edition":2,"checksum":"sha256:b6c672bb163512d45d97f7b01c5beb7488f91087dfe0f29850e62753d6739bdd"}
