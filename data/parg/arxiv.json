y":{"atom":13}},{"Repetition":{"atom":56,"min":1,"max":null,"tag":"Repetition"}},{"Named":{"name":"version","atom":57}},{"Sequence":{"atoms":[55,58]}},{"Repetition":{"atom":54,"min":0,"max":1,"tag":"Maybe"}},{"Sequence":{"atoms":[9,53,60]}}],"root":61},"bindings":[{"capture":"archive","path":"archive","type":"string","card":null,"preprocess":null},{"capture":"subject_class","path":"subject_class","type":"string","card":null,"preprocess":null},{"capture":"yymm","path":"yymm","type":"string","card":null,"preprocess":null},{"capture":"number","path":"number","type":"string","card":null,"preprocess":null},{"capture":"version","path":"version","type":"string","card":null,"preprocess":null}]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":"identifier","render":{},"derive":{},"tests":[{"entry":"identifier","kind":"accept","input":"arXiv:2301.00001v1","expect":{}},{"entry":"identifier","kind":"accept","input":"arxiv:0704.0001","expect":{}},{"entry":"identifier","kind":"accept","input":"arXiv hep-th/9901001v2","expect":{}},{"entry":"identifier","kind":"accept","input":"math.GT/0309136","expect":{}},{"entry":"identifier","kind":"reject","input":"nonsense","expect":{}},{"entry":"identifier","kind":"reject","input":"2301.001","expect":{}},{"entry":"identifier","kind":"reject","input":"hep-th/99010","expect":{}},{"entry":"identifier","kind":"example","input":"arXiv:2301.00001v1","expect":{"yymm":"2301","number":"00001","version":"1"}},{"entry":"identifier","kind":"example","input":"0704.0001","expect":{"yymm":"0704","number":"0001"}},{"entry":"identifier","kind":"example","input":"hep-th/9901001","expect":{"archive":"hep-th","yymm":"9901","number":"001"}},{"entry":"identifier","kind":"example","input":"math.GT/0309136v2","expect":{"archive":"math","subject_class":"GT","yymm":"0309","number":"136","version":"2"}}],"docs":{},"source":"# arXiv e-print identifiers, per\n# https://info.arxiv.org/help/arxiv_identifier_for_services.html:\n#   new form  YYMM.NNNN[vN] (0704-1412) and YYMM.NNNNN[vN] (1501 onward)\n#   old form  archive[.SC]/YYMMNNN[vN] (9108-0703)\n# with an optional, case-insensitive \"arXiv:\" or \"arXiv \" prefix.\n# The date ranges, the month and v0 are checked by the Ruby builder.\n\ngrammar PubidArxiv version \"0.1.0\" edition 2 {\n  digit = %x30-39\n  lower = %x61-7A\n  letter = %x41-5A / %x61-7A\n  arxiv_prefix = %i\"arXiv\" (colon / space)\n  yymm = (4digit) as yymm\n  new_number = (4*5digit) as number\n  new_id = yymm \".\" new_number\n  archive = (lower *(lower / \"-\")) as archive\n  subject_class = (letter *(letter / \"-\")) as subject_class\n  old_number = (3digit) as number\n  old_id = archive [\".\" subject_class] \"/\" yymm old_number\n  version = \"v\" (1*digit) as version\n  identifier = [arxiv_prefix] (new_id / old_id) [version]\n  space = \" \"\n  colon = \":\"\n  entry identifier: identifier\n\n  # Typed model bindings: every bound capture lands on the\n  # consumer model's field of the same name.\n  bindings identifier {\n    archive -> archive (string)\n    subject_class -> subject_class (string)\n    yymm -> yymm (string)\n    number -> number (string)\n    version -> version (string)\n  }\n\n\n  test {\n    accept \"arXiv:2301.00001v1\"\n    accept \"arxiv:0704.0001\"\n    accept \"arXiv hep-th/9901001v2\"\n    accept \"math.GT/0309136\"\n    reject \"nonsense\"\n    reject \"2301.001\"\n    reject \"hep-th/99010\"\n    example \"arXiv:2301.00001v1\" { yymm: \"2301\" number: \"00001\" version: \"1\" }\n    example \"0704.0001\" { yymm: \"0704\" number: \"0001\" }\n    example \"hep-th/9901001\" { archive: \"hep-th\" yymm: \"9901\" number: \"001\" }\n    example \"math.GT/0309136v2\" { archive: \"math\" subject_class: \"GT\" yymm: \"0309\" number: \"136\" version: \"2\" }\n  }\n}\n","source_hash":"c4b4676d738856a7717100c2a3a0545fa1e5a6b83fbf8b09b08dcbe1c33c4a5e","unicode_tables":"onigmo (Ruby 3.4.10)","compiler_version":"1.5.1.0","edition":2,"semantics_hash":"sha256:a7a76fd8f3dbc2635edef63cbb9451aba802e36dea8c4b616ddfdeed626834d1","checksum":"sha256:ccd0bf40ffcb0469e051ed63f14ce1786c88938ee56f12a3edd4ac45ea894512","validated":{"lint_errors":0,"lint_warnings":0,"tests_total":11,"tests_failures":0,"self_test":true},"byte_checksum":"sha256:b308269a659a039642ab933276733ecb6f71de1c3873b35ac3959dac4681c4ea"}
