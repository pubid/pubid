}],"root":50},"bindings":[{"capture":"tr_number","path":"tr_number","type":"string","card":null,"preprocess":null},{"capture":"mem_number","path":"mem_number","type":"string","card":null,"preprocess":null},{"capture":"number","path":"number","type":"string","card":null,"preprocess":null},{"capture":"part","path":"part","type":"string","card":null,"preprocess":null},{"capture":"edition","path":"edition","type":"string","card":null,"preprocess":null},{"capture":"volume","path":"volume","type":"string","card":null,"preprocess":null}]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":"identifier","render":{},"derive":{},"tests":[{"entry":"identifier","kind":"accept","input":"ECMA-262","expect":{}},{"entry":"identifier","kind":"accept","input":"ECMA TR/104","expect":{}},{"entry":"identifier","kind":"accept","input":"ECMA-262 ed3","expect":{}},{"entry":"identifier","kind":"reject","input":"nonsense","expect":{}}],"docs":{},"source":"# Port of lib/pubid/ecma/parser.rb: ECMA-NNN[-part], ECMA TR/NNN,\n# ECMA MEM/NNN, each with optional \" edX[.Y]\" and \" volN\". The TR/MEM\n# vs standard alternation relies on the disjoint first character after\n# the prefix (T/M are not digits), as in the source.\n\ngrammar PubidEcma version \"0.1.0\" edition 2 {\n  tr = \" TR/\" (1*digit) as tr_number\n  mem = \" MEM/\" (1*digit) as mem_number\n  standard = (\"-\" / \" \") (1*digit) as number [(\"-\" (1*digit) as part)]\n  edition_number = 1*digit *(dot 1*digit)\n  edition = \" ed\" (1*digit *(dot 1*digit)) as edition\n  volume = \" vol\" (1*digit) as volume\n  identifier = \"ECMA\" (tr / mem / standard) [edition] [volume]\n  digit = %x30-39\n  dot = \".\"\n  entry identifier: identifier\n\n  bindings identifier {\n    tr_number -> tr_number (string)\n    mem_number -> mem_number (string)\n    number -> number (string)\n    part -> part (string)\n    edition -> edition (string)\n    volume -> volume (string)\n  }\n\n\n  test {\n    accept \"ECMA-262\"\n    accept \"ECMA TR/104\"\n    accept \"ECMA-262 ed3\"\n    reject \"nonsense\"\n  }\n}\n","source_hash":"1cfa0626a6a2c339b2f7fae3eb80aabb1c19700525fd246dc04c880ab4212d59","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.114","edition":2,"checksum":"sha256:3dacea6949fa9f0e3834150c69d74b341da45bb49f7351604c3f421a954a06da"}
