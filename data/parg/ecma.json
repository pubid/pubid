:{"atoms":[0,28,43,50]}}],"root":51},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":"identifier","render":{},"derive":{},"tests":[{"entry":"identifier","kind":"accept","input":"ECMA-262","expect":{}},{"entry":"identifier","kind":"accept","input":"ECMA TR/104","expect":{}},{"entry":"identifier","kind":"accept","input":"ECMA-262 ed3","expect":{}},{"entry":"identifier","kind":"reject","input":"nonsense","expect":{}}],"docs":{},"source":"# Port of lib/pubid/ecma/parser.rb: ECMA-NNN[-part], ECMA TR/NNN,\n# ECMA MEM/NNN, each with optional \" edX[.Y]\" and \" volN\". The TR/MEM\n# vs standard alternation relies on the disjoint first character after\n# the prefix (T/M are not digits), as in the source.\n\ngrammar PubidEcma version \"0.1.0\" mode \"v1\" {\n  tr = \" TR/\" (1*digit) as tr_number\n  mem = \" MEM/\" (1*digit) as mem_number\n  standard = (\"-\" / \" \") (1*digit) as number [(\"-\" (1*digit) as part)]\n  edition_number = 1*digit *(dot 1*digit)\n  edition = \" ed\" edition_number as edition\n  volume = \" vol\" (1*digit) as volume\n  identifier = \"ECMA\" (tr / mem / standard) [edition] [volume]\n  digit = %x30-39\n  dot = \".\"\n  entry identifier: identifier\n\n  test {\n    accept \"ECMA-262\"\n    accept \"ECMA TR/104\"\n    accept \"ECMA-262 ed3\"\n    reject \"nonsense\"\n  }\n}\n","source_hash":"fc4e38614671daeb4022b0ebcfe3d18a80a8382e84783d6bd26348e3183a9508","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.112","edition":"v1","checksum":"sha256:a5946d7595ec77a28ad7f0924cb2e9573bca9a4d894a332d8fa348c0a24bdbe0"}
