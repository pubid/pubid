rnative":{"atoms":[156,157]}},{"Repetition":{"atom":158,"min":0,"max":1,"tag":"Maybe"}},{"Str":{"pattern":" "}},{"Entity":{"atom":110}},{"Sequence":{"atoms":[160,161]}},{"Repetition":{"atom":162,"min":0,"max":1,"tag":"Maybe"}},{"Sequence":{"atoms":[117,118,123,125,126,139,155,159,163]}},{"Named":{"name":"standard","atom":164}},{"Alternative":{"atoms":[0,63,115]}}],"root":166},"bindings":[{"capture":"interpretation","path":"interpretation","type":"raw","card":null,"preprocess":null},{"capture":"copublisher","path":"copublisher","type":"string","card":null,"preprocess":null},{"capture":"code","path":"code","type":"string","card":null,"preprocess":null},{"capture":"type","path":"type","type":"string","card":null,"preprocess":null},{"capture":"reaffirmed","path":"reaffirmed","type":"string","card":null,"preprocess":null},{"capture":"revision","path":"revision","type":"string","card":null,"preprocess":null},{"capture":"interpretation_code","path":"interpretation_code","type":"string","card":null,"preprocess":null},{"capture":"interpretation_year","path":"interpretation_year","type":"string","card":null,"preprocess":null},{"capture":"publication_keyword","path":"publication_keyword","type":"string","card":null,"preprocess":null},{"capture":"year","path":"year","type":"string","card":null,"preprocess":null}]}},"preprocess":{},"tables":{},"lint":{"order_warnings":["rule interpretation_identifier: branches 1 and 2 are order-dependent (shared first bytes; ordered choice is decisive)","rule identifier: branches 1 and 2 are order-dependent (shared first bytes; ordered choice is decisive)","rule identifier: branches 1 and 3 are order-dependent (shared first bytes; ordered choice is decisive)","rule identifier: branches 2 and 3 are order-dependent (shared first bytes; ordered choice is decisive)"]},"default_entry":"identifier","render":{},"derive":{},"tests":[{"entry":"identifier","kind":"accept","input":"AMCA 500-D","expect":{}},{"entry":"identifier","kind":"accept","input":"AMCA Standard 210","expect":{}},{"entry":"identifier","kind":"accept","input":"ANSI/AMCA 210","expect":{}},{"entry":"identifier","kind":"reject","input":"nonsense","expect":{}}],"docs":{},"source":"# Port of lib/pubid/amca/parser.rb. Pre-parse whitespace collapsing,\n# en-dash normalization and trailing punctuation stripping stay\n# binder-side.\n#\n# Edition 2: every reference inside a captured body is inlined to raw\n# terms (a rule reference materializes as a named node in the edition-2\n# tree, so only a raw capture binds a scalar span); references to rules\n# that themselves capture (copublisher, code, reaffirmation) float their\n# captures unchanged. The type wrappers (interpretation, publication,\n# standard) keep the v1 tree shape and the bindings name the scalar\n# leaves.\n\ngrammar PubidAmca version \"0.1.0\" edition 2 {\n  copublisher = ((\"ANSI\" \"/\" \"AMCA\") / \"AMCA\") as copublisher\n  code = {\n    ( 1*%x30-39\n      [(\"-\" (%x41-5A / %x61-7A))]\n      [(\".\" 1*%x30-39)] ) as code\n  }\n  reaffirmation = \"(\" \"R\" (1*%x30-39) as reaffirmed \")\"\n  revision = \"(\" \"Rev\" [\".\"] \" \" (1*%x30-39 \"-\" 1*%x30-39) as revision \")\"\n  interpretation_code = (2*(%x41-5A / %x61-7A) / 1*%x30-39) as interpretation_code\n\n  interpretation_identifier = {\n    (\n      ( [copublisher] \" \" code \" \"\n        ( (interpretation_code \" \" \"Interp\")\n          / ((\"–\" / \"-\") (1*%x30-39) as interpretation_year [\" \" \"Interp\"]) )\n      ) as interpretation\n    )\n    /\n    (\n      ( [copublisher] \" \" code \" \" \"Interp\" ) as interpretation\n    )\n  }\n  publication_identifier = {\n    (\n      ( [copublisher] \" \" \"Publication\" as publication_keyword \" \" code\n        [(\"-\" (((\"19\" / \"20\") 2*%x30-39) / (2*%x30-39)) as year)]\n        [(\" \" revision)]\n        [(\" \" reaffirmation)] ) as publication\n    )\n  }\n  standard_identifier = {\n    (\n      ( [copublisher] \" \" [(\"Standard\" / \"Publication\") as type] [\" \"] code\n        [(\"-\" (((\"19\" / \"20\") 2*%x30-39) / (2*%x30-39)) as year)]\n        [(\" \" \"/\" 2*10(%x41-5A / %x61-7A) \" \" 1*%x30-39 [(\"-\" 1*%x30-39)])]\n        [(\"R\" / \"P\")]\n        [(\" \" reaffirmation)] ) as standard\n    )\n  }\n  identifier = interpretation_identifier / publication_identifier / standard_identifier\n\n  entry identifier: identifier\n\n  test {\n    accept \"AMCA 500-D\"\n    accept \"AMCA Standard 210\"\n    accept \"ANSI/AMCA 210\"\n    reject \"nonsense\"\n  }\n\n  bindings identifier {\n    # The builder dispatches interpretation on the :interpretation wrapper\n    # when the code/keyword leaves are absent (branch 2 spellings), so the\n    # wrapper binds raw — the nested hash build_interpretation walks.\n    interpretation -> interpretation (raw)\n    copublisher -> copublisher (string)\n    code -> code (string)\n    type -> type (string)\n    reaffirmed -> reaffirmed (string)\n    revision -> revision (string)\n    interpretation_code -> interpretation_code (string)\n    interpretation_year -> interpretation_year (string)\n    publication_keyword -> publication_keyword (string)\n    year -> year (string)\n  }\n}\n","source_hash":"bceecc759a9fa419b558c9df856323bc3c9ca9d0e3ebccde9ed6a37695794a9c","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.114","edition":2,"checksum":"sha256:e10abef95a553ac47069d7971ae622b25fe12b6e2ba731bfec957cfc7afc7117"}
