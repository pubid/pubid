ax":1,"tag":"Maybe"}},{"Str":{"pattern":" "}},{"Repetition":{"atom":277,"min":0,"max":1,"tag":"Maybe"}},{"Str":{"pattern":":"}},{"Entity":{"atom":187}},{"Sequence":{"atoms":[279,280]}},{"Repetition":{"atom":281,"min":0,"max":1,"tag":"Maybe"}},{"Sequence":{"atoms":[274,276,278,282]}},{"Sequence":{"atoms":[229,231,233,270,272,273]}},{"Entity":{"atom":225}},{"Sequence":{"atoms":[228,285]}},{"Alternative":{"atoms":[0,227]}}],"root":287},"bindings":[{"capture":"publisher","path":"publisher","type":"string","card":null,"preprocess":null},{"capture":"number_with_part","path":"number_with_part","type":"string","card":null,"preprocess":null},{"capture":"base_number_with_part","path":"base_number_with_part","type":"string","card":null,"preprocess":null},{"capture":"date","path":"date","type":"string","card":null,"preprocess":null},{"capture":"base_date","path":"base_date","type":"string","card":null,"preprocess":null},{"capture":"stage_iteration","path":"stage_iteration","type":"string","card":null,"preprocess":null},{"capture":"base_stage_iteration","path":"base_stage_iteration","type":"string","card":null,"preprocess":null},{"capture":"type_with_stage","path":"type_with_stage","type":"string","card":null,"preprocess":null},{"capture":"base_type_with_stage","path":"base_type_with_stage","type":"string","card":null,"preprocess":null},{"capture":"all_parts","path":"all_parts","type":"string","card":null,"preprocess":null},{"capture":"languages","path":"languages","type":"string","card":null,"preprocess":null}]}},"preprocess":{},"tables":{"idf_typed_stages":{"file":"idf_typed_stages.yaml","rows":[{"abbr":"PWI RM"},{"abbr":"NP RM"},{"abbr":"AWI RM"},{"abbr":"WD RM"},{"abbr":"CD RM"},{"abbr":"PDRM"},{"abbr":"DRM"},{"abbr":"FDRM"},{"abbr":"PRF RM"},{"abbr":"RM"},{"abbr":"AMD"},{"abbr":"COR"},{"abbr":"PWI"},{"abbr":"NP"},{"abbr":"NWIP"},{"abbr":"AWI"},{"abbr":"WD"},{"abbr":"CD"},{"abbr":"FCD"},{"abbr":"DIS"},{"abbr":"FPD"},{"abbr":"FDIS"},{"abbr":"PRF"},{"abbr":"Fpr"},{"abbr":"WDR"},{"abbr":"WDA"},{"abbr":"WDAR"}]},"idf_typed_stages_supplements":{"file":"idf_typed_stages_supplements.yaml","rows":[{"abbr":"AMD"},{"abbr":"COR"}]}},"lint":{"order_warnings":["rule dash: branches 2 and 3 are order-dependent (shared first bytes; ordered choice is decisive)","rule identifier: branches 1 and 2 are order-dependent (shared first bytes; ordered choice is decisive)"]},"default_entry":"identifier","render":{},"derive":{},"tests":[],"docs":{},"source":"# Port of lib/pubid/idf/parser.rb: IDF identifiers and their\n# supplements. The ISO joint form (ISO 5537|IDF 26) inlines these rules\n# as idf_* in iso.pg.\n#\n# Edition-2 notes: number_with_part inlines the number and\n# part_and_subpart bodies fully to raw terms at the capture site (a\n# capture wrapping rule refs expands to element hashes, while the\n# inlined body binds as one scalar string). The supplement base wrapper\n# capture drops (the bindings cannot nest); within a supplement the base\n# portion captures under base_* names so the supplement layer keeps the\n# canonical number_with_part/date/type_with_stage captures — the values\n# the builder read at top level — mirroring the csa part_* per-position\n# convention.\n\ngrammar PubidIdf version \"0.1.0\" edition 2 {\n  digit = %x30-39\n  word_char = %x30-39 / %x41-5A / %x61-7A / %x5F\n  dash = \"-\" / \"‑\" / \"‐\"\n  dot = \".\"\n  slash = \"/\"\n  space = \" \"\n  colon = \":\"\n  letter = %x41-5A / %x61-7A\n  lower = %x61-7A\n  century = \"19\" / \"20\"\n  year_digits = century 2*digit !digit\n  month_digits = 2*digit\n  day_digits = 2*digit\n  publisher = \"IDF\" as publisher\n  number_with_part = {\n    (\n      1*5(%x30-39 / %x41-5A / %x61-7A / %x5F)\n      [\n        dash [\" \"]\n        1*(%x30-39 / %x41-5A / %x61-7A / %x5F)\n        *1( dash 1*(%x30-39 / %x41-5A / %x61-7A / %x5F) )\n      ]\n    ) as number_with_part\n  }\n  date = {\n    (\n      (\"19\" / \"20\") 2*digit !digit\n      [(dash 2*digit)]\n      [(dash 2*digit)]\n    ) as date\n  }\n  stage_iteration = \".\" digit as stage_iteration\n  second_part = number_with_part [stage_iteration] [\" \"] [( \":\" date )]\n  all_parts = \"(all parts)\" as all_parts\n  language = \"(\" ( *( 1*lower [\",\"] / ( one_of_efards [slash] ) ) ) as languages \")\"\n  one_of_efards = %x45 / %x46 / %x41 / %x52 / %x44 / %x53\n  third_part = [\" \"] [language] [all_parts]\n  identifier_publisher_no_third = {\n    publisher [\" \"] [\"/\"] [type_with_stage] [\" \"] second_part\n  }\n  identifier_publisher = identifier_publisher_no_third third_part\n  type_with_stage = {\n    (\n      alt from_table \"idf_typed_stages\" column \"abbr\"\n    ) as type_with_stage\n    [digit as stage_iteration \" \"]\n  }\n  # Supplement side: the supplement layer keeps the canonical\n  # type_with_stage/number_with_part/date captures (what the builder\n  # read at top level); its base portion captures under base_* names so\n  # the two layers never collapse onto each other.\n  supplement_type_with_stage = {\n    (\n      alt from_table \"idf_typed_stages_supplements\" column \"abbr\"\n    ) as type_with_stage\n  }\n  base_number_with_part = {\n    (\n      1*5(%x30-39 / %x41-5A / %x61-7A / %x5F)\n      [\n        dash [\" \"]\n        1*(%x30-39 / %x41-5A / %x61-7A / %x5F)\n        *1( dash 1*(%x30-39 / %x41-5A / %x61-7A / %x5F) )\n      ]\n    ) as base_number_with_part\n  }\n  base_date = {\n    (\n      (\"19\" / \"20\") 2*digit !digit\n      [(dash 2*digit)]\n      [(dash 2*digit)]\n    ) as base_date\n  }\n  base_stage_iteration = \".\" digit as base_stage_iteration\n  base_second_part = base_number_with_part [base_stage_iteration] [\" \"] [( \":\" base_date )]\n  base_type_with_stage = {\n    (\n      alt from_table \"idf_typed_stages\" column \"abbr\"\n    ) as base_type_with_stage\n    [digit as base_stage_iteration \" \"]\n  }\n  supplement_base_no_third = {\n    publisher [\" \"] [\"/\"] [base_type_with_stage] [\" \"] base_second_part\n  }\n  supplement_second_part = number_with_part [stage_iteration] [\" \"] [( \":\" date )]\n  supplement_identifier_no_third = {\n    supplement_base_no_third [\" \"] \"/\" [\" \"] supplement_type_with_stage [\" \"] supplement_second_part\n  }\n  supplement_identifier = supplement_identifier_no_third third_part\n  identifier = supplement_identifier / identifier_publisher\n\n  entry identifier: identifier\n\n  bindings identifier {\n    publisher -> publisher (string)\n    number_with_part -> number_with_part (string)\n    base_number_with_part -> base_number_with_part (string)\n    date -> date (string)\n    base_date -> base_date (string)\n    stage_iteration -> stage_iteration (string)\n    base_stage_iteration -> base_stage_iteration (string)\n    type_with_stage -> type_with_stage (string)\n    base_type_with_stage -> base_type_with_stage (string)\n    all_parts -> all_parts (string)\n    languages -> languages (string)\n  }\n}\n","source_hash":"adf15539b2c63baa49e70c4ffe48fdbe92a797d5eccb8f47832055a8b16daf16","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.114","edition":2,"checksum":"sha256:f69e7efbffb4a664e092e17135e77977598e3788e001f7b98c60617278ec0322"}
