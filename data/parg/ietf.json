{"bindings":null,"version":"0.1.0","grammar":"PubidIetf","shape":"parsanol-tree/v2","binding_version":1,"entries":{"identifier":{"root":"identifier","grammar":{"atoms":[{"Entity":{"atom":9}},{"Str":{"pattern":"RFC"}},{"Entity":{"atom":3}},{"Str":{"pattern":" "}},{"Repetition":{"atom":2,"min":0,"max":1,"tag":"Maybe"}},{"Entity":{"atom":6}},{"Re":{"pattern":"[\\x30-\\x39]"}},{"Repetition":{"atom":5,"min":1,"max":null,"tag":"Repetition"}},{"Named":{"name":"number","atom":7}},{"Sequence":{"atoms":[1,4,8]}},{"Entity":{"atom":21}},{"Str":{"pattern":"BCP"}},{"Str":{"pattern":"STD"}},{"Str":{"pattern":"FYI"}},{"Alternative":{"atoms":[11,12,13]}},{"Named":{"name":"series","atom":14}},{"Entity":{"atom":3}},{"Repetition":{"atom":16,"min":0,"max":1,"tag":"Maybe"}},{"Entity":{"atom":6}},{"Repetition":{"atom":18,"min":1,"max":null,"tag":"Repetition"}},{"Named":{"name":"number","atom":19}},{"Sequence":{"atoms":[15,17,20]}},{"Entity":{"atom":35}},{"Str":{"pattern":"draft-"}},{"Entity":{"atom":32}},{"Re":{"pattern":"[\\x30-\\x39]"}},{"Re":{"pattern":"[\\x41-\\x5a]"}},{"Re":{"pattern":"[\\x61-\\x7a]"}},{"Re":{"pattern":"[+]"}},{"Re":{"pattern":"[_]"}},{"Re":{"pattern":"[.]"}},{"Re":{"pattern":"[\\-]"}},{"Alternative":{"atoms":[25,26,27,28,29,30,31]}},{"Repetition":{"atom":24,"min":1,"max":null,"tag":"Repetition"}},{"Named":{"name":"draft_rest","atom":33}},{"Sequence":{"atoms":[23,34]}},{"Alternative":{"atoms":[0,10,22]}}],"root":36},"bindings":[{"capture":"number","path":"number","type":"string","card":null,"preprocess":null},{"capture":"series","path":"series","type":"string","card":null,"preprocess":null},{"capture":"draft_rest","path":"draft_rest","type":"string","card":null,"preprocess":null}]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":"identifier","render":{},"derive":{},"tests":[{"entry":"identifier","kind":"accept","input":"RFC 2616","expect":{}},{"entry":"identifier","kind":"accept","input":"RFC2616","expect":{}},{"entry":"identifier","kind":"accept","input":"BCP 14","expect":{}},{"entry":"identifier","kind":"accept","input":"draft-ietf-httpbis-messaging-19","expect":{}},{"entry":"identifier","kind":"reject","input":"nonsense","expect":{}}],"docs":{},"source":"# Port of lib/pubid/ietf/parser.rb: three families keyed on the leading\n# token — RFC, sub-series (BCP/STD/FYI, padded forms allowed), and\n# Internet-Drafts (the wide draft tail is safe: the alternation is\n# leading-token keyed).\n\ngrammar PubidIetf version \"0.1.0\" edition 2 {\n  rfc = \"RFC\" [space] (1*digit) as number\n  subseries = (\"BCP\" / \"STD\" / \"FYI\") as series [space] (1*digit) as number\n  draft_rest_char = %x30-39 / %x41-5A / %x61-7A / %x2B / %x5F / %x2E / %x2D\n  draft = \"draft-\" (1*draft_rest_char) as draft_rest\n  identifier = rfc / subseries / draft\n  digit = %x30-39\n  space = \" \"\n  entry identifier: identifier\n\n  # Typed model bindings: every bound capture lands on the\n  # consumer model's field of the same name.\n  bindings identifier {\n    number -> number (string)\n    series -> series (string)\n    draft_rest -> draft_rest (string)\n  }\n\n\n  test {\n    accept \"RFC 2616\"\n    accept \"RFC2616\"\n    accept \"BCP 14\"\n    accept \"draft-ietf-httpbis-messaging-19\"\n    reject \"nonsense\"\n  }\n}\n","source_hash":"787ab890250efb10ee4e20e0e5835d5894f903080f4871d354ac5298ce9d2064","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.114","edition":2,"checksum":"sha256:66503a4cb4efaaafc7b0fdc7f6590e02d1cc0fc39815a1ee22caecb0c5f0b714"}
