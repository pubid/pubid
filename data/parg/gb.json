{"bindings":null,"version":"0.1.0","grammar":"PubidGb","shape":"parsanol-tree/v2","binding_version":1,"entries":{"identifier":{"root":"identifier","grammar":{"atoms":[{"Entity":{"atom":23}},{"Str":{"pattern":"T/"}},{"Entity":{"atom":5}},{"Re":{"pattern":"[\\x41-\\x5a]"}},{"Re":{"pattern":"[\\x30-\\x39]"}},{"Alternative":{"atoms":[3,4]}},{"Repetition":{"atom":2,"min":1,"max":null,"tag":"Repetition"}},{"Sequence":{"atoms":[1,6]}},{"Str":{"pattern":"GBn"}},{"Str":{"pattern":"/T"}},{"Str":{"pattern":"/Z"}},{"Alternative":{"atoms":[9,10]}},{"Repetition":{"atom":11,"min":0,"max":1,"tag":"Maybe"}},{"Sequence":{"atoms":[8,12]}},{"Entity":{"atom":15}},{"Re":{"pattern":"[\\x41-\\x5a]"}},{"Repetition":{"atom":14,"min":1,"max":3,"tag":"Repetition"}},{"Str":{"pattern":"/T"}},{"Str":{"pattern":"/Z"}},{"Alternative":{"atoms":[17,18]}},{"Repetition":{"atom":19,"min":0,"max":1,"tag":"Maybe"}},{"Sequence":{"atoms":[16,20]}},{"Alternative":{"atoms":[7,13,21]}},{"Named":{"name":"publisher_code","atom":22}},{"Entity":{"atom":25}},{"Str":{"pattern":" "}},{"Entity":{"atom":27}},{"Re":{"pattern":"[\\x30-\\x39]"}},{"Repetition":{"atom":26,"min":1,"max":null,"tag":"Repetition"}},{"Named":{"name":"number","atom":28}},{"Str":{"pattern":"."}},{"Entity":{"atom":27}},{"Repetition":{"atom":31,"min":1,"max":null,"tag":"Repetition"}},{"Named":{"name":"part","atom":32}},{"Sequence":{"atoms":[30,33]}},{"Repetition":{"atom":34,"min":0,"max":1,"tag":"Maybe"}},{"Entity":{"atom":39}},{"Str":{"pattern":"-"}},{"Str":{"pattern":"—"}},{"Alternative":{"atoms":[37,38]}},{"Named":{"name":"dash","atom":36}},{"Entity":{"atom":27}},{"Repetition":{"atom":41,"min":4,"max":4,"tag":"Repetition"}},{"Named":{"name":"year","atom":42}},{"Sequence":{"atoms":[40,43]}},{"Repetition":{"atom":44,"min":0,"max":1,"tag":"Maybe"}},{"Str":{"pattern":" ("}},{"Entity":{"atom":48}},{"Str":{"pattern":"all parts"}},{"Named":{"name":"all_parts_text","atom":47}},{"Str":{"pattern":")"}},{"Sequence":{"atoms":[46,49,50]}},{"Repetition":{"atom":51,"min":0,"max":1,"tag":"Maybe"}},{"Sequence":{"atoms":[0,24,29,35,45,52]}}],"root":53},"bindings":[{"capture":"publisher_code","path":"publisher_code","type":"string","card":null,"preprocess":null},{"capture":"number","path":"number","type":"string","card":null,"preprocess":null},{"capture":"part","path":"part","type":"string","card":null,"preprocess":null},{"capture":"year","path":"year","type":"string","card":null,"preprocess":null}]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":"identifier","render":{},"derive":{},"tests":[{"entry":"identifier","kind":"accept","input":"GB/T 19001-2016","expect":{}},{"entry":"identifier","kind":"accept","input":"GB 4943","expect":{}},{"entry":"identifier","kind":"reject","input":"nonsense","expect":{}}],"docs":{},"source":"# Port of lib/pubid/gb/parser.rb — Chinese standard identifiers.\n# publisher_code order is load-bearing: the social-group form, then the\n# confidential GBn series (lowercase n is part of the code), then the\n# general 1-3-letter code. The year separator is ASCII dash or the\n# Chinese typographic em-dash.\n\ngrammar PubidGb version \"0.1.0\" edition \"v2\" {\n  publisher_code = ((\"T/\" 1*upper_digit) / (\"GBn\" [\"/T\" / \"/Z\"]) / (1*3upper [\"/T\" / \"/Z\"])) as publisher_code\n  identifier = publisher_code space (1*digit) as number [(\".\" (1*digit) as part)] [(dash (4digit) as year)] [(\" (\" all_parts_text \")\")]\n  all_parts_text = \"all parts\"\n  upper = %x41-5A\n  upper_digit = %x41-5A / %x30-39\n  dash = \"-\" / \"—\"\n  space = \" \"\n  digit = %x30-39\n  entry identifier: identifier\n\n  # Typed model bindings: every bound capture lands on the\n  # consumer model's field of the same name.\n  bindings identifier {\n    publisher_code -> publisher_code (string)\n    number -> number (string)\n    part -> part (string)\n    year -> year (string)\n  }\n\n\n  test {\n    accept \"GB/T 19001-2016\"\n    accept \"GB 4943\"\n    reject \"nonsense\"\n  }\n}\n","source_hash":"9bee0de5adb02481a553d17b247aeba4ddc8a2d6dca4ee75c0244b3034eaa8fa","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.112","edition":"v2","checksum":"sha256:33b010ac711252ca4f2e1eb92b909d727b5aa5a01ed2bfcd7a2e2dc692bd6331"}
