tr":{"pattern":"("}},{"Entity":{"atom":25}},{"Repetition":{"atom":111,"min":4,"max":4,"tag":"Repetition"}},{"Named":{"name":"year","atom":112}},{"Entity":{"atom":45}},{"Named":{"name":"dash","atom":114}},{"Entity":{"atom":25}},{"Repetition":{"atom":116,"min":2,"max":2,"tag":"Repetition"}},{"Named":{"name":"month","atom":117}},{"Str":{"pattern":")"}},{"Sequence":{"atoms":[110,113,115,118,119]}},{"Sequence":{"atoms":[108,109]}},{"Repetition":{"atom":121,"min":0,"max":1,"tag":"Maybe"}},{"Sequence":{"atoms":[0,1,19,21,64,75,87,107,122]}}],"root":123},"bindings":[{"capture":"type","path":"type","type":"string","card":null,"preprocess":null},{"capture":"number","path":"number","type":"string","card":null,"preprocess":null},{"capture":"minor","path":"minor","type":"string","card":null,"preprocess":null},{"capture":"part","path":"parts[].part","type":"string","card":null,"preprocess":null},{"capture":"version","path":"version","type":"string","card":null,"preprocess":null},{"capture":"edition","path":"edition","type":"string","card":null,"preprocess":null},{"capture":"year","path":"year","type":"string","card":null,"preprocess":null},{"capture":"month","path":"month","type":"string","card":null,"preprocess":null},{"capture":"supplement_kind","path":"supplements[].supplement_kind","type":"string","card":null,"preprocess":null},{"capture":"supplement_number","path":"supplements[].supplement_number","type":"string","card":null,"preprocess":null}]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":"identifier","render":{},"derive":{},"tests":[{"entry":"identifier","kind":"accept","input":"ETSI EN 300 175","expect":{}},{"entry":"identifier","kind":"accept","input":"ETSI TR 101 999","expect":{}},{"entry":"identifier","kind":"reject","input":"nonsense","expect":{}}],"docs":{},"source":"# Port of lib/pubid/etsi/parser.rb: ETSI <one of 15 types> <number>\n# [minor][-parts][/A..|/C..][ V<version> | ed.N] [(YYYY-MM)].\n\ngrammar PubidEtsi version \"0.1.0\" edition 2 {\n  type = (\"I-ETS\" / \"TCRTR\" / \"GTS\" / \"ETR\" / \"ETS\" / \"TBR\" / \"NET\" / \"EN\" / \"ES\" / \"EG\" / \"TS\" / \"GR\" / \"GS\" / \"SR\" / \"TR\") as type\n  # The monorepo's number is a single flat string (\"300 058\", \"298\") —\n  # the inner pieces are structural only, never surfaced as captures.\n  gsm_with_space_number = \"GSM\" space 1*digit dot 1*digit\n  dotted_number = 1*digit dot 1*digit\n  complex_number = 1*alnum_char [(dash 1*alnum_char)] space 1*digit\n  simple_number = 1*digit\n  number = ((\"GSM\" space 1*digit dot 1*digit) / (1*digit dot 1*digit) / (1*alnum_char [(dash 1*alnum_char)] space 1*digit) / (1*digit)) as number\n  minor = space (1*digit) as minor\n  part = dash (1*alnum_char) as part\n  parts = (*part) as parts\n  version = \"V\" (1*version_char) as version\n  edition = \"ed.\" (1*digit) as edition\n  version_or_edition = version / edition\n  date_part = \"(\" (4digit) as year dash (2digit) as month \")\"\n  single_supplement = ((\"/A\" / \"/C\") as supplement_kind (1*digit) as supplement_number)\n  supplements = 1*single_supplement\n  identifier = \"ETSI \" type space number [minor] [parts] [supplements] [(space version_or_edition)] [(space date_part)]\n  alnum_char = %x41-5A / %x61-7A / %x30-39\n  version_char = %x30-39 / %x2E\n  digit = %x30-39\n  dash = \"-\"\n  dot = \".\"\n  space = \" \"\n  entry identifier: identifier\n\n  # Typed model bindings: repeated parts collect under parts[].part and\n  # the supplements pair kind with number by occurrence index.\n  bindings identifier {\n    type -> type (string)\n    number -> number (string)\n    minor -> minor (string)\n    part -> parts[].part (string)\n    version -> version (string)\n    edition -> edition (string)\n    year -> year (string)\n    month -> month (string)\n    supplement_kind -> supplements[].supplement_kind (string)\n    supplement_number -> supplements[].supplement_number (string)\n  }\n\n  \n  test {\n    accept \"ETSI EN 300 175\"\n    accept \"ETSI TR 101 999\"\n    reject \"nonsense\"\n  }\n}\n","source_hash":"fcd65f026fe04cb23ccdd6420b18ad5548bc05206afa3cf6e4d2e7e0757e6a1b","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.114","edition":2,"checksum":"sha256:3a8bf872b82ff0c51cb2a9e6ed5aed3815a6a16b2830d77f7b185b8a10cd640e"}
