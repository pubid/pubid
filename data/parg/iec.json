tifier (IEC x | ISO y) awaits PG cross-file imports; the\n#   ISO joint grammar cannot be inlined at reasonable size. Noted here;\n#   slots back into the root ahead of identifier_copublishers.\n# - the IEV → \"IEC 60050\" input shorthand is pre-parse normalization and\n#   stays binder-side.\n\ngrammar PubidIec version \"0.1.0\" {\n  digit = %x30-39\n  upper = %x41-5A\n  lower = %x61-7A\n  letter = upper / lower\n  alnum_char = upper / lower / digit\n  word_ext_char = alnum_char / %x5F / %x26 / %x2C\n  space = \" \"\n  dash = \"-\" / \"‑\" / \"‐\"\n  dot = \".\"\n  slash = \"/\"\n  colon = \":\"\n  comma = \",\"\n  century = \"19\" / \"20\"\n  year_digits = century 2*digit !digit\n  month_digits = 2*digit\n  day_digits = 2*digit\n  digits = 1*digit\n\n  ## IEC publishers, longest-first: the qualified forms must precede\n  ## the bare \"IEC\".\n  prefix_sole_publisher = (\"IECQ OD\" / \"IECQ CS\" / \"IEC CAB\" / \"IEC CA\" / \"IECRE\" / \"CISPR\" / \"IECEE\" / \"IECEx\" / \"IECQ\" / \"IEC\" / \"ISO\") as publisher\n  organization = \"IEC\" / \"ISO\" / \"IEEE\" / \"CIW\" / \"SAE\" / \"CIE\" / \"ASME\" / \"ASTM\" / \"OECD\" / \"HL7\" / \"CEI\" / \"UNDP\"\n  copublishers_item = slash [space] organization as copublisher\n  copublishers = (*copublishers_item) as copublishers\n  prefix_with_copublishers = prefix_sole_publisher [space] [copublishers]\n\n  tc_type = \"JTC\" / \"JPC\" / \"TC\" / \"SC\" / \"PC\"\n  tc_body = \"CISPR\" / (\"CIS\" slash upper) / (tc_type space digits [*upper])\n  sc_body = \"SC\" space digits [*upper]\n  technical_group_with_publisher = (prefix_sole_publisher [copublishers] space tc_body as technical_committee [((slash [space] sc_body) as subcommittee)])\n  technical_group_bare = (tc_body as technical_committee [((slash [space] sc_body) as subcommittee)])\n  technical_group = technical_group_with_publisher / technical_group_bare\n\n  wp_type = ((\"TR\" / \"TS\" / \"SRD\") space) as wp_type\n  wp_number = ((1*letter *alnum_char [(dash 1*digit)]) as number_with_part) / number_with_part\n  working_programme = ((\"PWI\" / \"PNW\") as wp_stage space [wp_type] wp_number [(space edition)])\n\n  working_document = (((\"JTC1-SC\" 1*digit) / (1*upper slash 1*upper) / 1*alnum_char) as technical_committee slash (1*alnum_char) as wd_number [(\"(\" upper as wd_language \")\")] [(slash (1*upper) as wd_stage)])\n\n  number = ((\"DIR\" *(space 1*upper_digit)) / \"VIM\" / \"SYMBOL\" / (1*6digit \"v\" 1*digit *letter [(\"_\" 1*letter)]) / (2*4upper [(dash 1*digit)] *upper_digit) / (1*6digit [*1letter [(\"_\" 1*letter)]]))\n  upper_digit = upper / digit\n  part_and_subpart = (dash / comma) [space] 1*word_ext_char *((dash / comma) 1*word_ext_char)\n  number_with_part = (number [part_and_subpart]) as number_with_part\n  trf_org_number = (\"CISPR\" space) as trf_org number_with_part\n  stage_iteration = dot digit as stage_iteration\n\n  undated = \"--\" / \"—\"\n  full_date = (year_digits [(dash month_digits)] [(dash day_digits)]) as date\n  date_body = undated as undated_marker / full_date\n  date = (colon / dash) date_body\n\n  vap_code = \"CSV\" / \"CMV\" / \"RLV\" / \"SER\" / \"EXV\" / \"PAC\" / \"PRV\"\n  vap_suffix = space (vap_code *(dash vap_code)) as vap_suffix\n  database_suffix = space \"DB\" as database\n  consolidated_supplement = \"+\" (\"AMD\" / \"COR\") as supplement_type (1*digit) as supplement_number [(colon year_digits as supplement_year)]\n  consolidated_supplements = (1*consolidated_supplement) as consolidated_supplements\n  second_part = (trf_org_number / number_with_part) [stage_iteration] [[space] date] [consolidated_supplements] [vap_suffix / database_suffix]\n\n  edition_str = \"Edition\" / \"Ed.\" / \"ED\" / \"Ed\"\n  edition = edition_str [space] (1*digit [(dot 1*digit)]) as edition\n\n  one_of_efards = %x45 / %x46 / %x41 / %x52 / %x44 / %x53\n  lower_char = lower\n  languages = (*(1*lower_char [\",\"] / (one_of_efards [slash]))) as languages\n  language = \"(\" languages \")\"\n  all_parts = \"(all parts)\"\n  fragment_notation = slash (\"FRAGC\" / \"FRAG\") as fragment_type (1*digit) as fragment_number\n  third_part_edition = [space] [edition]\n  third_part = third_part_edition [language] [fragment_notation] [all_parts]\n\n  type_with_stage = alt from_table \"iec_typed_stages\" column \"abbr\" as type_with_stage [digit as stage_iteration space]\n  supplement_type_with_stage = (alt from_table \"iec_typed_stages\" column \"abbr\" / \"FRAGC\" / \"FRAG\") as type_with_stage\n\n  guide_prefix = \"Guide\" / \"GUIDE\"\n  identifier_copublishers_no_third = [guide_prefix as type_with_stage_fr space] [prefix_with_copublishers] [space] [slash] (type_with_stage / \"\" as type_with_stage) [space] second_part third_part_edition\n  identifier_copublishers = identifier_copublishers_no_third third_part\n\n  sheet_notation = slash (1*digit) as sheet_number colon year_digits as sheet_year\n  sheet_notation_no_year = slash (1*digit) as sheet_number\n  sheet_identifier = (identifier_copublishers_no_third as base) (sheet_notation / sheet_notation_no_year)\n  sheet_supplement_identifier = (identifier_copublishers_no_third as base) sheet_notation slash supplement_type_with_stage [space] second_part third_part\n  standalone_supplement = prefix_with_copublishers slash supplement_type_with_stage space second_part third_part\n  supplement_identifier_no_third = (identifier_copublishers_no_third as base) slash supplement_type_with_stage [space] second_part\n  supplement_identifier = supplement_identifier_no_third third_part\n  supplement_supplement_identifier = (supplement_identifier_no_third as base) slash supplement_type_with_stage [space] second_part third_part\n\n  identifier = working_programme / technical_group / working_document / sheet_supplement_identifier / sheet_identifier / supplement_supplement_identifier / standalone_supplement / supplement_identifier / identifier_copublishers\n\n  entry identifier: identifier\n\n  test {\n    accept \"IEC 60050\"\n    accept \"IEC 8601-1:2019\"\n    accept \"CISPR 16-1-1\"\n    accept \"IECQ OD 1234\"\n    accept \"IEC/TS 80000-1\"\n    reject \"nonsense\"\n  }\n}\n","checksum":"sha256:d5db838b75a857309c1e2feb75f25a719ed62b416640f4b1f9a6d165956a53c2"}
