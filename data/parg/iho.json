:{}},{"entry":"identifier","kind":"accept","input":"IHO S-5 Appendix 2","expect":{}},{"entry":"identifier","kind":"reject","input":"nonsense","expect":{}}],"docs":{},"source":"# Port of lib/pubid/iho/parser.rb — IHO identifiers: letter series\n# (S/P/M/B/C), a number with an optional suffix, and appendix, part,\n# annex, supplement and version tails.\n\ngrammar PubidIho version \"0.1.0\" edition 1 {\n  digit = %x30-39\n  upper = %x41-5A\n  lower = %x61-7A\n  letter = upper / lower\n  space = \" \"\n  dash = \"-\"\n  dot = \".\"\n\n  series = (\"S\" / \"P\" / \"M\" / \"B\" / \"C\") as type\n  number_suffix = ((\":\" 1*digit) / (\"/\" 1*digit) / (dash 1*digit) / upper)\n  number = (1*digit [number_suffix]) as number\n  appendix = {\n    space (\"Appendix\" / \"Ap.\") space\n    ((upper dash 1*digit) / (1*digit) / upper) as appendix\n  }\n  part = {\n    space \"Part\" space\n    ((1*digit *letter) / upper) as part\n  }\n  annex = space \"Annex\" space upper as annex\n  supplement = space \"Suppl\" space (1*digit) as supplement\n  version = space (1*digit dot 1*digit dot 1*digit) as version\n\n  identifier = {\n    [(\"IHO\" space)]\n    series\n    dash\n    number\n    [appendix]\n    [part]\n    [annex]\n    [supplement]\n    [version]\n  }\n\n  entry identifier: identifier\n\n  test {\n    accept \"S-5\"\n    accept \"IHO S-5 Appendix 2\"\n    reject \"nonsense\"\n  }\n}\n","source_hash":"451ea6a7794cd2704c13985640321faf1ca11f04271ae0bd2817e9061c8655b8","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.114","edition":1,"checksum":"sha256:cef923c87b2b0b1bd8b62cd87b40240b176ce03050eb079fed62de69ba4804c6"}
