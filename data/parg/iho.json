7}},{"Repetition":{"atom":115,"min":1,"max":null,"tag":"Repetition"}},{"Named":{"name":"volume","atom":116}},{"Entity":{"atom":2}},{"Str":{"pattern":"No."}},{"Entity":{"atom":2}},{"Entity":{"atom":17}},{"Repetition":{"atom":121,"min":1,"max":null,"tag":"Repetition"}},{"Named":{"name":"issue","atom":122}},{"Sequence":{"atoms":[118,119,120,123]}},{"Repetition":{"atom":124,"min":0,"max":1,"tag":"Maybe"}},{"Sequence":{"atoms":[112,113,114,117,125]}},{"Alternative":{"atoms":[91,105,111]}},{"Repetition":{"atom":127,"min":0,"max":1,"tag":"Maybe"}},{"Sequence":{"atoms":[4,5,13,15,55,73,81,90,128]}}],"root":129},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":"identifier","render":{},"derive":{},"tests":[{"entry":"identifier","kind":"accept","input":"S-5","expect":{}},{"entry":"identifier","kind":"accept","input":"IHO S-5 Appendix 2","expect":{}},{"entry":"identifier","kind":"accept","input":"IHO P-5 2024","expect":{}},{"entry":"identifier","kind":"accept","input":"IHO P-1 Vol. 30","expect":{}},{"entry":"identifier","kind":"accept","input":"IHO P-1 Vol. 30 No. 1","expect":{}},{"entry":"identifier","kind":"accept","input":"IHO P-1/30 1.0.0","expect":{}},{"entry":"identifier","kind":"reject","input":"IHO P-5 24","expect":{}},{"entry":"identifier","kind":"reject","input":"IHO P-5 2024 1.0.0","expect":{}},{"entry":"identifier","kind":"reject","input":"IHO P-1 No. 1","expect":{}},{"entry":"identifier","kind":"reject","input":"nonsense","expect":{}}],"docs":{},"source":"# Port of lib/pubid/iho/parser.rb — IHO identifiers: letter series\n# (S/P/M/B/C), a number with an optional suffix, and appendix, part,\n# annex and supplement tails, then one of a version, a year (series\n# publications with no edition: P-5, P-6, P-7) or a volume with an\n# optional issue (the International Hydrographic Review, P-1).\n\ngrammar PubidIho version \"0.1.0\" edition 1 {\n  digit = %x30-39\n  upper = %x41-5A\n  lower = %x61-7A\n  letter = upper / lower\n  space = \" \"\n  dash = \"-\"\n  dot = \".\"\n\n  series = (\"S\" / \"P\" / \"M\" / \"B\" / \"C\") as type\n  number_suffix = ((\":\" 1*digit) / (\"/\" 1*digit) / (dash 1*digit) / upper)\n  number = (1*digit [number_suffix]) as number\n  appendix = {\n    space (\"Appendix\" / \"Ap.\") space\n    ((upper dash 1*digit) / (1*digit) / upper) as appendix\n  }\n  part = {\n    space \"Part\" space\n    ((1*digit *letter) / upper) as part\n  }\n  annex = space \"Annex\" space upper as annex\n  supplement = space \"Suppl\" space (1*digit) as supplement\n  version = space (1*digit dot 1*digit dot 1*digit) as version\n  year = space (4digit) as year\n  volume = {\n    space \"Vol.\" space (1*digit) as volume\n    [space \"No.\" space (1*digit) as issue]\n  }\n\n  identifier = {\n    [(\"IHO\" space)]\n    series\n    dash\n    number\n    [appendix]\n    [part]\n    [annex]\n    [supplement]\n    [version / year / volume]\n  }\n\n  entry identifier: identifier\n\n  test {\n    accept \"S-5\"\n    accept \"IHO S-5 Appendix 2\"\n    accept \"IHO P-5 2024\"\n    accept \"IHO P-1 Vol. 30\"\n    accept \"IHO P-1 Vol. 30 No. 1\"\n    accept \"IHO P-1/30 1.0.0\"\n    reject \"IHO P-5 24\"\n    reject \"IHO P-5 2024 1.0.0\"\n    reject \"IHO P-1 No. 1\"\n    reject \"nonsense\"\n  }\n}\n","source_hash":"4ccdb66e20e7c2f474c4445408848ef83fe70575c1bb889da2bd9ddb493ef99b","unicode_tables":"onigmo (Ruby 3.4.10)","compiler_version":"1.3.114","edition":1,"checksum":"sha256:93600d1ca5bca947fd926e6021e9dd418f03792f0051b0392586d525a9854eb8"}
