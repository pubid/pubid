{"bindings":null,"version":"0.1.0","grammar":"PubidDoi","shape":"parsanol-tree/v2","binding_version":1,"entries":{"identifier":{"root":"identifier","grammar":{"atoms":[{"Entity":{"atom":8}},{"Str":{"pattern":"https://"}},{"Str":{"pattern":"http://"}},{"Alternative":{"atoms":[1,2]}},{"Repetition":{"atom":3,"min":0,"max":1,"tag":"Maybe"}},{"Str":{"pattern":"doi.org"}},{"Repetition":{"atom":5,"min":0,"max":1,"tag":"Maybe"}},{"Sequence":{"atoms":[4,6]}},{"Repetition":{"atom":7,"min":0,"max":1,"tag":"Maybe"}},{"Named":{"name":"url_prefix","atom":0}},{"Repetition":{"atom":9,"min":0,"max":1,"tag":"Maybe"}},{"Entity":{"atom":16}},{"Str":{"pattern":"doi:"}},{"Str":{"pattern":"DOI:"}},{"Str":{"pattern":"Doi:"}},{"Alternative":{"atoms":[12,13,14]}},{"Repetition":{"atom":15,"min":0,"max":1,"tag":"Maybe"}},{"Named":{"name":"scheme_prefix","atom":11}},{"Repetition":{"atom":17,"min":0,"max":1,"tag":"Maybe"}},{"Entity":{"atom":20}},{"Str":{"pattern":"/"}},{"Named":{"name":"slash","atom":19}},{"Repetition":{"atom":21,"min":0,"max":1,"tag":"Maybe"}},{"Entity":{"atom":30}},{"Str":{"pattern":"10"}},{"Str":{"pattern":"."}},{"Entity":{"atom":27}},{"Re":{"pattern":"[\\x30-\\x39]"}},{"Repetition":{"atom":26,"min":2,"max":null,"tag":"Repetition"}},{"Named":{"name":"prefix","atom":28}},{"Sequence":{"atoms":[24,25,29]}},{"Entity":{"atom":20}},{"Named":{"name":"slash","atom":31}},{"Entity":{"atom":46}},{"Entity":{"atom":44}},{"Re":{"pattern":"[\\x30-\\x39]"}},{"Re":{"pattern":"[\\x41-\\x5a]"}},{"Re":{"pattern":"[\\x61-\\x7a]"}},{"Re":{"pattern":"[.]"}},{"Re":{"pattern":"[_]"}},{"Re":{"pattern":"[\\-]"}},{"Re":{"pattern":"[/]"}},{"Re":{"pattern":"[(]"}},{"Re":{"pattern":"[)]"}},{"Alternative":{"atoms":[35,36,37,38,39,40,41,42,43]}},{"Repetition":{"atom":34,"min":1,"max":null,"tag":"Repetition"}},{"Named":{"name":"suffix","atom":45}},{"Sequence":{"atoms":[10,18,22,23,32,33]}}],"root":47},"bindings":[{"capture":"prefix","path":"prefix","type":"string","card":null,"preprocess":null},{"capture":"suffix","path":"suffix","type":"string","card":null,"preprocess":null}]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":"identifier","render":{},"derive":{},"tests":[{"entry":"identifier","kind":"accept","input":"10.1000/182","expect":{}},{"entry":"identifier","kind":"accept","input":"doi:10.1000/182","expect":{}},{"entry":"identifier","kind":"accept","input":"https://doi.org/10.1000/182","expect":{}},{"entry":"identifier","kind":"reject","input":"nonsense","expect":{}}],"docs":{},"source":"# Port of lib/pubid/doi/parser.rb: [doi:|DOI:|URL]10.{registrar}/{suffix}\n# per ISO 26324. Suffix is printable non-whitespace minus the DOI-reserved\n# exclusions, per the parslet class.\n\ngrammar PubidDoi version \"0.1.0\" edition 2 {\n  digit = %x30-39\n  suffix_char = %x30-39 / %x41-5A / %x61-7A / %x2E / %x5F / %x2D / %x2F / %x28 / %x29\n  doi_prefix = \"10\" \".\" (2*digit) as prefix\n  doi_suffix = (1*suffix_char) as suffix\n  url_prefix = [[\"https://\" / \"http://\"] [\"doi.org\"]]\n  scheme_prefix = [\"doi:\" / \"DOI:\" / \"Doi:\"]\n  identifier = [url_prefix] [scheme_prefix] [slash] doi_prefix slash doi_suffix\n  slash = \"/\"\n  entry identifier: identifier\n\n  # Typed model bindings: every bound capture lands on the\n  # consumer model's field of the same name.\n  bindings identifier {\n    prefix -> prefix (string)\n    suffix -> suffix (string)\n  }\n\n\n  test {\n    accept \"10.1000/182\"\n    accept \"doi:10.1000/182\"\n    accept \"https://doi.org/10.1000/182\"\n    reject \"nonsense\"\n  }\n}\n","source_hash":"2dcec2cb79a4c6364080a573d3aa748a4464bbd38ace020ced13418cd33290a8","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.114","edition":2,"checksum":"sha256:5e13576a62c82050481b0bacbffd66232d1dfd43b75c0e6230289cf11d8671f9"}
