ispatches on plus_separator /\n  # comma_separator. Each part_ capture wraps a kept 1* repetition so\n  # the binding-path validator sees it repeated.\n  csa_code_first = publisher_first 1*(code_pattern_part) [trailing_block_part]\n  csa_code_part = [publisher_first] 1*(code_pattern_part) [trailing_block_part] [amendment_slash]\n  publisher_first = 1*((\"CSA\" space) as part_has_publisher)\n  code_pattern_part = 1*((1*digit dot 1*digit *1(dash 1*digit) [2*6upper]) / (1*digit 2*6upper) / (upper 1*digit *(dot 1*digit) *(dash ((digit !digit) / 3*digit / (1*digit 1*letter))) [2*6upper]) / (upper 1*digit [dot 1*digit]) / (upper 2*digit)) as part_code\n  trailing_block_part = ((part_no_notation part_no_number (part_colon_year / part_dash_year)) / (space part_series_prefix space 1*(\"SERIES\" as part_series) (part_colon_year / part_dash_year)) / (space 1*(\"SERIES\" as part_series) (part_colon_year / part_dash_year)) / (part_colon_year / part_dash_year))\n  part_no_notation = space 1*((\"NO.\" / \"No.\") as part_no_notation) space\n  part_no_number = 1*((1*digit 2*10(dash 1*digit)) / (5*digit dash 1*digit) / (3*4digit dash ((digit !digit) / 3*digit)) / (1*digit 1*3(dot 1*digit)) / 1*digit) as part_no_number\n  part_series_prefix = 1*((2*6upper) as part_series_prefix)\n  part_colon_year = 1*(colon) as part_colon_format ((part_year_prefix (4digit) as part_year) / (part_year_prefix (2digit) as part_year) / (4digit) as part_year / (2digit) as part_year)\n  part_dash_year = 1*(dash) as part_dash_format ((part_year_prefix (4digit) as part_year) / (part_year_prefix (2digit) as part_year) / (4digit) as part_year / (2digit) as part_year)\n  part_year_prefix = 1*((\"F\" / \"M\") as part_year_prefix)\n  bundled_portion_first = 1*(code_pattern_part) ((part_no_notation part_no_number [(part_colon_year / part_dash_year)]) / [(part_colon_year / part_dash_year)])\n\n  identifier = iso_iec_adoption / series_identifier / cec_identifier / bundled_identifier / combined_slash / combined_comma / single_identifier / code_only_identifier\n\n  comma = \",\"\n  dash = \"-\"\n  slash = \"/\"\n  colon = \":\"\n  dot = \".\"\n  ampersand = \"&\"\n  letter = upper / lower\n  entry identifier: identifier\n\n  bindings identifier {\n    has_publisher -> has_publisher (string)\n    code -> code (string)\n    no_notation -> no_notation (string)\n    no_number -> no_number (string)\n    year_prefix -> year_prefix (string)\n    colon_format -> colon_format (string)\n    year -> year (string)\n    dash_format -> dash_format (string)\n    amendment_number -> amendment_number (string)\n    amendment_year -> amendment_year (string)\n    series_prefix -> series_prefix (string)\n    series_type -> series_type (string)\n    cec_part -> cec_part (string)\n    adoption_pub -> adoption_pub (string)\n    adoption_org -> adoption_org (string)\n    iso_type -> iso_type (string)\n    adoption_number -> adoption_number (string)\n    adoption_org_with_type -> adoption_org_with_type (string)\n    adoption_year_sep -> adoption_year_sep (string)\n    adoption_year -> adoption_year (string)\n    adoption_amendment -> adoption_amendment (string)\n    adoption_amendment_year -> adoption_amendment_year (string)\n    series -> series (string)\n    plus_separator -> plus_separator (string)\n    reaffirmation_4digit -> reaffirmation_4digit (string)\n    reaffirmation_2digit -> reaffirmation_2digit (string)\n    comma_separator -> comma_separator (string)\n    package_portion -> package_portion (string)\n    part_code -> csa_code_part[].part_code (string)\n    part_year -> csa_code_part[].part_year (string)\n    part_colon_format -> csa_code_part[].part_colon_format (string)\n    part_dash_format -> csa_code_part[].part_dash_format (string)\n    part_year_prefix -> csa_code_part[].part_year_prefix (string)\n    part_no_notation -> csa_code_part[].part_no_notation (string)\n    part_no_number -> csa_code_part[].part_no_number (string)\n    part_series -> part_series (string)\n    part_series_prefix -> part_series_prefix (string)\n    part_has_publisher -> csa_code_part[].part_has_publisher (string)\n  }\n\n\n  test {\n    accept \"CSA Z259.1-05\"\n    accept \"CSA C22.2 NO. 60601-1\"\n    accept \"CSA Z195-02\"\n    reject \"nonsense\"\n  }\n}\n","source_hash":"140fdd18f7004e65d8782ecde151ea56ef14eca8af7ba9fac3490bdc1c42cbc6","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.114","edition":2,"checksum":"sha256:5a60fb60747f812498701256ef1bc0d02c174ad2fcca6de80076a2ac0c052d19"}
