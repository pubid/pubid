null,"preprocess":null},{"capture":"version","path":"version","type":"string","card":null,"preprocess":null},{"capture":"part","path":"parts[].part","type":"string","card":null,"preprocess":null},{"capture":"year","path":"year","type":"string","card":null,"preprocess":null},{"capture":"adopted_string","path":"adopted_string","type":"string","card":null,"preprocess":null},{"capture":"edition","path":"edition","type":"string","card":null,"preprocess":null},{"capture":"amendment_number","path":"amendment_number","type":"string","card":null,"preprocess":null},{"capture":"amendment_year","path":"amendment_year","type":"string","card":null,"preprocess":null},{"capture":"fragment_number","path":"fragment_number","type":"string","card":null,"preprocess":null},{"capture":"supplement","path":"supplements[].supplement","type":"raw","card":null,"preprocess":null}]}},"preprocess":{},"tables":{},"lint":{"order_warnings":["rule cen_cenelec.publisher: branches 1 and 2 are order-dependent (shared first bytes; ordered choice is decisive)","rule cen_cenelec.publisher: branches 1 and 3 are order-dependent (shared first bytes; ordered choice is decisive)","rule cen_cenelec.publisher: branches 2 and 3 are order-dependent (shared first bytes; ordered choice is decisive)","rule cen_cenelec.date: branches 1 and 2 are order-dependent (shared first bytes; ordered choice is decisive)","rule cen_cenelec.fragment_identifier: branches 1 and 2 are order-dependent (shared first bytes; ordered choice is decisive)","rule cen_cenelec.identifier: branches 1 and 2 are order-dependent (shared first bytes; ordered choice is decisive)"]},"default_entry":"identifier","render":{},"derive":{},"tests":[{"entry":"identifier","kind":"accept","input":"EVS-EN 18216:2026","expect":{}},{"entry":"identifier","kind":"accept","input":"EVS-EN ISO 9001:2015/A1:2024","expect":{}},{"entry":"identifier","kind":"accept","input":"EVS EN 196-1:2016","expect":{}},{"entry":"identifier","kind":"accept","input":"EVS 921:2019","expect":{}},{"entry":"identifier","kind":"accept","input":"EVS-TS 1:2019","expect":{}},{"entry":"identifier","kind":"accept","input":"EVS-TR 1:2019","expect":{}},{"entry":"identifier","kind":"accept","input":"EVS-ISO 9001:2015","expect":{}},{"entry":"identifier","kind":"accept","input":"EVS-IEC 62368-1:2020","expect":{}},{"entry":"identifier","kind":"accept","input":"EVS-EN 1993-1-1:2005+NA:2010","expect":{}},{"entry":"identifier","kind":"accept","input":"EVS-EN 1993-1-1:2005/NA","expect":{}},{"entry":"identifier","kind":"accept","input":"EVS-EN 50581:2012+COR:2015","expect":{}},{"entry":"identifier","kind":"accept","input":"EVS-EN 50581:2012+AC:2015","expect":{}},{"entry":"identifier","kind":"accept","input":"EVS-EN 71-1:2011 AMD1:2014","expect":{}},{"entry":"identifier","kind":"accept","input":"prEVS-EN 100:2026","expect":{}},{"entry":"identifier","kind":"reject","input":"nonsense","expect":{}},{"entry":"cen_cenelec.identifier","kind":"accept","input":"EN 18216:2026","expect":{}},{"entry":"cen_cenelec.identifier","kind":"accept","input":"EN ISO 9001:2015","expect":{}},{"entry":"cen_cenelec.identifier","kind":"accept","input":"CEN/CLC TR 17161:2019","expect":{}},{"entry":"cen_cenelec.identifier","kind":"accept","input":"EN 196-1:2016+A1","expect":{}},{"entry":"cen_cenelec.identifier","kind":"accept","input":"CEN/CLC/ETSI/TR 101551:2026","expect":{}},{"entry":"cen_cenelec.identifier","kind":"accept","input":"EN 302 326-2:2026","expect":{}},{"entry":"cen_cenelec.identifier","kind":"accept","input":"EN 302 326-2 V2.2.1","expect":{}},{"entry":"cen_cenelec.identifier","kind":"accept","input":"EN 302 326 V2.2.1:2026","expect":{}},{"entry":"cen_cenelec.identifier","kind":"accept","input":"EN 302:2026","expect":{}},{"entry":"cen_cenelec.identifier","kind":"reject","input":"nonsense","expect":{}}],"docs":{},"source":"# The EVS national identifier: the national prefix (\"EVS\" / \"prEVS\") over a\n# CEN/CENELEC adoption, an ISO/IEC adoption, or a plain Estonian standard —\n# plus the EVS-list supplements (national annex, corrigendum, AMD amendment)\n# and the language code. The CEN spine is IMPORTED via `use` (TODO 11/C6\n# imports): rules are namespaced cen_cenelec.* while captures keep their\n# contract names.\n#\n# Edition 2: every reference inside a captured body is inlined to raw\n# terms (a rule reference materializes as a named node in the edition-2\n# tree, so only a raw capture binds a scalar span). The branch wrappers\n# (adopted, intl, plain) and the supplement wrappers (evs_amd, evs_cor,\n# na) keep the v1 tree shape and the bindings name the scalar leaves.\n\nuse cen_cenelec\n\ngrammar PubidEvs version \"0.3.0\" edition 2 {\n  identifier = [draft_prefix] \"EVS\" evs_separator ((cen_cenelec.identifier) as adopted / (evs_intl) as intl / (evs_plain) as plain) [evs_amd] [evs_cor / evs_ac] [evs_na]\n\n  draft_prefix = \"pr\" as draft_prefix\n  evs_separator = (\"-\" / \" \") as evs_separator\n\n  # \"EVS-ISO 9001:2015\", \"EVS-IEC 62368-1:2020\" (+ their amendments)\n  evs_intl = {\n    (\n      (((\"ISO\" / \"IEC\") as intl_org) \" \" (1*%x30-39) as number)\n      [(\"-\" (1*%x30-39) as part)]\n      [(\":\" (4*4%x30-39) as year)]\n    )\n  }\n  # \"EVS 921:2019\", \"EVS-TS 1:2019\", \"EVS-TR 1:2019\"\n  evs_plain = {\n    ([((\"TS\" / \"TR\") as evs_type) \" \"]) (1*%x30-39) as number [(\":\" (4*4%x30-39) as year)]\n  }\n\n  # \" AMD1:2014\" / \"+AMD1\" — the AMD amendment spelling; the separator is\n  # semantic (list: \"+A full standard plus the amendment\", \"/A only amendment\")\n  evs_amd = {\n    (\n      ((\"+\" as supp_plus / \"/\" as supp_slash / \" \" as supp_space) (\"AMD\" as amd_kind))\n      (1*%x30-39) as amd_number\n      [(\":\" (4*4%x30-39) as amd_year)]\n    ) as evs_amd\n  }\n  # \"+COR:2015\" / \"/COR\" — the COR spelling (the CEN spine consumes +AC itself)\n  evs_cor = {\n    (\n      ((\"+\" as supp_plus / \"/\" as supp_slash) (\"COR\" as cor_kind))\n      [(1*%x30-39) as cor_number]\n      [(\":\" (4*4%x30-39) as cor_year)]\n    ) as evs_cor\n  }\n  # \" AC:2015\" — the space-separated AC spelling\n  evs_ac = {\n    (\n      (\" \" as supp_space) (\"AC\" as cor_kind)\n      [(1*%x30-39) as cor_number]\n      [(\":\" (4*4%x30-39) as cor_year)]\n    ) as evs_cor\n  }\n  # \"+NA:2010\" / \"/NA\" — the national annex\n  evs_na = {\n    (\n      ((\"+\" as supp_plus / \"/\" as supp_slash) \"NA\")\n      [(\":\" (4*4%x30-39) as na_year)]\n    ) as na\n  }\n  # The trailing language code (\" et\" / \" en\" / \" et-en\") is extracted by\n  # the parse wrapper (Pubid::Evs.parse) BEFORE the grammar runs — the\n  # CEN adopted_string is greedy over plain text and would swallow it.\n\n  entry identifier: identifier\n\n  test {\n    accept \"EVS-EN 18216:2026\"\n    accept \"EVS-EN ISO 9001:2015/A1:2024\"\n    accept \"EVS EN 196-1:2016\"\n    accept \"EVS 921:2019\"\n    accept \"EVS-TS 1:2019\"\n    accept \"EVS-TR 1:2019\"\n    accept \"EVS-ISO 9001:2015\"\n    accept \"EVS-IEC 62368-1:2020\"\n    accept \"EVS-EN 1993-1-1:2005+NA:2010\"\n    accept \"EVS-EN 1993-1-1:2005/NA\"\n    accept \"EVS-EN 50581:2012+COR:2015\"\n    accept \"EVS-EN 50581:2012+AC:2015\"\n    accept \"EVS-EN 71-1:2011 AMD1:2014\"\n    accept \"prEVS-EN 100:2026\"\n    reject \"nonsense\"\n  }\n\n  bindings identifier {\n    # The builder dispatches on the branch and supplement wrappers and\n    # reads every leaf from inside them (evs/builder.rb: data[:adopted] is\n    # rebuilt by the CEN builder, data[:intl]/data[:plain]/data[:na] are\n    # read member-wise) — so all six wrappers bind uncast, the v1 nested\n    # shape. Only the two flat spine fields the builder reads directly stay\n    # scalar; the branch leaves are nested-only and bind no flat copies.\n    draft_prefix -> draft_prefix (string)\n    evs_separator -> evs_separator (string)\n    adopted -> adopted (raw)\n    intl -> intl (raw)\n    plain -> plain (raw)\n    evs_amd -> evs_amd (raw)\n    evs_cor -> evs_cor (raw)\n    na -> na (raw)\n  }\n}\n","source_hash":"de754f6405971118d0c6b9c39870a30f2266beb864d90556ffe012739b128e1b","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.114","edition":2,"checksum":"sha256:3ef754570c9845f45ab26206de64028a74bbe67f37dc481478702e26b8227422"}
