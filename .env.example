# Local, gitignored overrides for the optional pubid-testsuite conformance corpus.
# Copy this file to .env and point PUBID_TESTSUITE_PATH at your local checkout of
# https://github.com/pubid/pubid-testsuite, as a path relative to this repo's root
# (resolved against the repo root, not your shell's cwd) — never an absolute path,
# since those don't carry over between host and container checkouts.
PUBID_TESTSUITE_PATH=../pubid-testsuite
